local function executeHitLoop()
    local targetIndex, lastChar = 1, nil
    while commandHitLooping do
        local char = LocalPlayer.Character
        if char and char ~= lastChar then
            lastChar = char
            task.spawn(function()
                task.wait(0.5)
                if commandHitLooping then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                    task.wait(0.05); VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                end
            end)
        end
        if #activeHitTargets > 0 then
            if getOnlineTargetCount(activeHitTargets) == 0 then task.wait(1) continue end
            if targetIndex > #activeHitTargets then targetIndex = 1 end
            local targetUserId = activeHitTargets[targetIndex]
            local targetPlayer = Players:GetPlayerByUserId(targetUserId)
            if targetPlayer and isProtectedUser(targetPlayer) then continue end
            if char and char:FindFirstChild("HumanoidRootPart") and targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local targetHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                if targetHum then
                    if targetPlayer.Character:FindFirstChildOfClass("ForceField") then targetIndex = targetIndex + 1; task.wait(0.1) continue end
                    local now = tick()
                    local lastF = hitLastFSpam[targetUserId] or 0
                    if now - lastF >= 15 then
                        if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            hrp.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                        task.wait(0.05); VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                        hitLastFSpam[targetUserId] = tick()
                        task.wait(0.3)
                    end
                    if commandHitLooping then
                        if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            hrp.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end
                        local health = targetHum.Health
                        local cam = workspace.CurrentCamera
                        local center = cam.ViewportSize / 2
                        if health <= 1.5 and health > 0 then
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                            task.wait(0.05); VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        else
                            VirtualInputManager:SendMouseButtonEvent(math.floor(center.X), math.floor(center.Y), 0, true, game, 0)
                            task.wait(0.05); VirtualInputManager:SendMouseButtonEvent(math.floor(center.X), math.floor(center.Y), 0, false, game, 0)
                        end
                    end
                else task.wait(0.1) end
            else task.wait(0.1) end
            targetIndex = targetIndex + 1
        else task.wait(0.1) end
        task.wait(0.15)
    end
end

