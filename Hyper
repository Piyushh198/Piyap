local function executeGlitchForTarget(targetUserId)
    local targetPlayer = Players:GetPlayerByUserId(targetUserId)
    if not targetPlayer or isProtectedUser(targetPlayer) then return false end
    if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
    if targetPlayer.Character:FindFirstChildOfClass("ForceField") then return false end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    local targetHRP = targetPlayer.Character.HumanoidRootPart
    local rng = Random.new()
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = targetHRP.CFrame * CFrame.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))
    return true
end

local function executeGlitchLoop()
    local noclip, lastChar, targetIndex = nil, nil, 1
    while commandGlitchLooping do
        local char = LocalPlayer.Character
        if char ~= lastChar then
            if noclip then noclip:Disconnect() end
            if char and char:FindFirstChild("HumanoidRootPart") then
                noclip = RunService.Stepped:Connect(function()
                    for _, child in next, char:GetDescendants() do if child:IsA("BasePart") then child.CanCollide = false end end
                end)
            end
            lastChar = char
        end
        if #activeGlitchTargets > 0 then
            if getOnlineTargetCount(activeGlitchTargets) == 0 then task.wait(1); continue end
            if targetIndex > #activeGlitchTargets then targetIndex = 1 end
            local success = executeGlitchForTarget(activeGlitchTargets[targetIndex])
            if success then task.wait(0.05) else task.wait(0.1) end
            targetIndex = targetIndex + 1
        else task.wait(0.1) end
    end
    if noclip then noclip:Disconnect() end
end

