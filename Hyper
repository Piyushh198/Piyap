local function isProtectedUser(player)
    if not player then return false end
    for _, name in ipairs({"HackMystic67", "FracturedLogik"}) do
        if string.lower(player.Name) == string.lower(name) or string.lower(player.DisplayName) == string.lower(name) then return true end
    end
    return false
end

local function checkTriedProtected(q)
    local s = string.lower(q or "")
    if s == "all" or s == "others" then return true end
    for _, p in ipairs(Players:GetPlayers()) do
        if isProtectedUser(p) then
            if string.find(s, string.lower(p.Name), 1, true) or string.find(s, string.lower(p.DisplayName), 1, true) then return true end
        end
    end
    return false
end

local function makeDraggable(topbar, gui, scaleFactor)
    scaleFactor = scaleFactor or 1
    local dragging, dragInput, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    topbar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = (input.Position - dragStart) / scaleFactor
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

