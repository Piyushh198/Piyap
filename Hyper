            setFloatingStopButton("glue", "🛑 STOP GLUE", true, function() runCommand("unglue") end)
        else showNotification("❌ ERROR", "No valid targets.", Theme.Danger) end
    elseif cmdName == "unglue" then
        commandGlueLooping = false; activeGlueTargets = {}
        setFloatingStopButton("glue", "", false)
        showNotification("🛑 STOPPED", "Glue disabled.", Theme.Danger)
