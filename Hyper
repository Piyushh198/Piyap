local function checkUndoState(cmd)
    if cmd == "unhit" then return commandHitLooping end
    if cmd == "unglitch" then return commandGlitchLooping end
    if cmd == "unvoid" then return commandVoidLooping end
    if cmd == "unkill" then return commandKillLooping end
    if cmd == "untrap" then return commandTrapLooping end
    if cmd == "unesp" then return isESP end
    if cmd == "unnoclip" then return isNoclipping end
    if cmd == "unfreecam" then return isFreecam end
    if cmd == "unantivoid" then return antiVoidPart ~= nil end
    if cmd == "unspider" then return isSpider end
    if cmd == "unchaos" then return isChaos end
    if cmd == "uncamlock" then return isCamLock end
    if cmd == "unglue" then return commandGlueLooping end
    if cmd == "unantifling" then return isAntiFling end
    if cmd == "unfakelag" then return isFakeLag end
    if cmd == "unnametags" then return isNameTags end
    if cmd == "closecmdbar" then return cmdBarActive end
    if cmd == "unxray" then return isXray end
    if cmd == "unghost" then return isGhost end
    if cmd == "untoolfling" then return isToolFling end
    if cmd == "unspectate" then return spectateGui ~= nil end
    if cmd == "unspin" then return isSpinbot end
    if cmd == "unwaterwalk" then return isWaterWalk end
    if cmd == "unreach" then return isReach end
    if cmd == "vis" then return isInvisible end
    if cmd == "unbhop" then return isBhop end
    if cmd == "unnightvision" or cmd == "unnv" then return isNightVision end
    if cmd == "unrainbow" then return isRainbowBody end
    if cmd == "unfloat" then return isFloat end
    if cmd == "unautoclick" then return isAutoClicker end
    if cmd == "uninfhealth" then return isInfiniteHealth end
    if cmd == "unglow" then return isGlow end
    if cmd == "unflashlight" then return isFlashlight end
    if cmd == "ungravity" then return isZeroGravity or isHighGravity end
    if cmd == "unshake" then return isCameraShake end
    if cmd == "unfullbright" or cmd == "unfb" then return isFullBrightness end
    if cmd == "unspinfast" then return isSpinFast end
    if cmd == "untimefreeze" then return isTimeFreeze end
    return false
end

