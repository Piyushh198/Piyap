local function getOnlineTargetCount(list, ignoreUserId)
    local count = 0
    for _, item in ipairs(list) do
        local id = type(item) == "table" and item.targetId or item
        if id ~= ignoreUserId and Players:GetPlayerByUserId(id) then count = count + 1 end
    end
    return count
end

local function getTargetNamesString(targetIds)
    if not targetIds or #targetIds == 0 then return "None" end
    local names = {}
    for _, id in ipairs(targetIds) do
        local p = Players:GetPlayerByUserId(id)
        if p then table.insert(names, p.DisplayName) end
    end
    if #names == 0 then return "Unknown Player" end
    return table.concat(names, ", ")
end

local function getTargetUserIds(query)
    local targets = {}
    query = string.match(query or "", "^%s*(.-)%s*$")
    if query == "" then query = "me" end
    local function isValid(p, isExplicit)
        if isProtectedUser(p) then return false end 
        if p == LocalPlayer and not isExplicit then return false end
        return true
    end

    if query == "all" or query == "others" then
        for _, p in ipairs(Players:GetPlayers()) do if isValid(p, false) then table.insert(targets, p.UserId) end end
    elseif query == "random" then
        local valid = {}
        for _, p in ipairs(Players:GetPlayers()) do if isValid(p, false) then table.insert(valid, p.UserId) end end
        if #valid > 0 then table.insert(targets, valid[math.random(1, #valid)]) end
    elseif query == "me" then
        table.insert(targets, LocalPlayer.UserId)
    else
        for namePart in string.gmatch(query, "([^,]+)") do
            local subQuery = string.match(namePart, "^%s*(.-)%s*$")
            if subQuery and subQuery ~= "" then
                if subQuery == "me" then
                    if not table.find(targets, LocalPlayer.UserId) then table.insert(targets, LocalPlayer.UserId) end
                    continue
                end
                local foundExact = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if string.lower(p.Name) == subQuery or string.lower(p.DisplayName) == subQuery then
                        if isValid(p, true) and not table.find(targets, p.UserId) then
                            table.insert(targets, p.UserId); foundExact = true
                        end
                    end
                end
                if not foundExact then
                    for _, p in ipairs(Players:GetPlayers()) do
                        local tName = string.lower(p.Name)
                        local tDisplay = string.lower(p.DisplayName)
                        if string.find(tName, subQuery, 1, true) or string.find(tDisplay, subQuery, 1, true) then
                            if isValid(p, true) and not table.find(targets, p.UserId) then table.insert(targets, p.UserId) end
                            break 
                        end
                    end
                end
            end
        end
    end
    return targets
end

