    cmdBarFrame.Parent = ActiveScreenGui
    Instance.new("UICorner", cmdBarFrame).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke", cmdBarFrame)
    stroke.Color = Theme.Accent1; stroke.Thickness = 2; stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local icon = Instance.new("TextLabel", cmdBarFrame)
    icon.Size = UDim2.new(0, 40, 1, 0); icon.BackgroundTransparency = 1
    icon.Text = "💋"; icon.Font = Enum.Font.GothamBold; icon.TextSize = 14; icon.TextColor3 = Theme.Text

    cmdBarBox = Instance.new("TextBox", cmdBarFrame)
    cmdBarBox.Size = UDim2.new(1, -50, 1, 0); cmdBarBox.Position = UDim2.new(0, 40, 0, 0)
    cmdBarBox.BackgroundTransparency = 1; cmdBarBox.TextColor3 = Theme.Text
    cmdBarBox.PlaceholderText = "Type command... (Type 'close' to exit)"; cmdBarBox.PlaceholderColor3 = Theme.TextMuted
    cmdBarBox.Font = Enum.Font.GothamMedium; cmdBarBox.TextSize = 13; cmdBarBox.TextXAlignment = Enum.TextXAlignment.Left

    cmdBarBox.FocusLost:Connect(function(enterPressed)
        if enterPressed and cmdBarBox.Text ~= "" then
            local cmdText = string.lower(string.match(cmdBarBox.Text, "^%s*(.-)%s*$"))
            cmdBarBox.Text = ""
            if cmdText == "close" then
                closeCmdBar()
                return
            end
            runCommand(cmdText)
            task.wait(0.1)
            if cmdBarActive then cmdBarBox:CaptureFocus() end
        end
    end)
end

