local function closeCmdBar()
    if cmdBarActive then
        cmdBarActive = false
        if cmdBarFrame then
            local tw = TweenService:Create(cmdBarFrame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Position = UDim2.new(0.5, -175, 0, -150)})
            tw:Play()
            cmdBarBox:ReleaseFocus()
            tw.Completed:Connect(function()
                if not cmdBarActive then cmdBarFrame.Visible = false end
            end)
        end
        showNotification("🛑 CMDBAR", "Command bar closed.", Theme.Danger)
    end
end

local function buildCmdBar()
    if cmdBarFrame then return end
    cmdBarFrame = Instance.new("Frame")
    cmdBarFrame.Size = UDim2.new(0, 350, 0, 46)
    cmdBarFrame.Position = UDim2.new(0.5, -175, 0, -150)
    cmdBarFrame.BackgroundColor3 = Theme.Surface
