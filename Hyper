runCommand = function(cmdName)
    local query = ""
    if string.find(cmdName, " ") then
        local parts = string.split(cmdName, " ")
        cmdName = parts[1]
        query = table.concat(parts, " ", 2)
    else
        query = TargetTextBox and TargetTextBox.Text or "me"
    end
    if query == "" then query = "me" end
    
    if checkTriedProtected(query) then
        pcall(function() LocalPlayer.Character:BreakJoints() end)
        showNotification("⚠️ BOSS PENALTY", "Tried commanding a protected developer!", Theme.Danger)
        return
    end

    if cmdName == "hit" or cmdName == "chaos" then
        if closeUI then closeUI() end
    end

    local newTargets = getTargetUserIds(query)
    local targetNamesStr = getTargetNamesString(newTargets)

    -- CORE COMBAT
    if cmdName == "hit" then
        if #newTargets > 0 then
            activeHitTargets = newTargets; for _, id in ipairs(activeHitTargets) do hitLastFSpam[id] = 0 end
            commandHitLooping = true; task.spawn(executeHitLoop)
            showNotification("⚔️ HIT", "Target(s): " .. targetNamesStr, Theme.Success)
            setFloatingStopButton("hit", "🛑 STOP HIT", true, function() runCommand("unhit") end)
        else showNotification("❌ ERROR", "No valid targets.", Theme.Danger) end
    elseif cmdName == "unhit" then
        commandHitLooping = false; activeHitTargets = {}; hitLastFSpam = {}
        setFloatingStopButton("hit", "", false)
        showNotification("🛑 STOPPED", "Hit loop disabled.", Theme.Danger)
    elseif cmdName == "glitch" then
        if #newTargets > 0 then
            activeGlitchTargets = newTargets; commandGlitchLooping = true; task.spawn(executeGlitchLoop)
            showNotification("🐝 GLITCH", "Target(s): " .. targetNamesStr, Theme.Success)
            setFloatingStopButton("glitch", "🛑 STOP GLITCH", true, function() runCommand("unglitch") end)
        else showNotification("❌ ERROR", "No valid targets.", Theme.Danger) end
    elseif cmdName == "unglitch" then
        commandGlitchLooping = false; activeGlitchTargets = {}
        setFloatingStopButton("glitch", "", false)
        showNotification("🛑 STOPPED", "Glitch sequence disabled.", Theme.Danger)
    elseif cmdName == "void" then
        if #newTargets > 0 then
            activeVoidTargets = newTargets; commandVoidLooping = true
            task.spawn(function()
                local targetIndex = 1
                while commandVoidLooping do
                    if #activeVoidTargets > 0 then
                        if getOnlineTargetCount(activeVoidTargets) == 0 then task.wait(1) continue end
                        if targetIndex > #activeVoidTargets then targetIndex = 1 end
                        local targetUserId = activeVoidTargets[targetIndex]
                        local tp = Players:GetPlayerByUserId(targetUserId)
                        if tp and isProtectedUser(tp) then targetIndex = targetIndex + 1 continue end
                        while not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") do
                            task.wait(0.1); if not commandVoidLooping then return end
                        end
                        executeVoidForTarget(targetUserId); task.wait(2.5)
                        targetIndex = targetIndex + 1
                    else task.wait(0.1) end
                end
            end)
            showNotification("🌌 VOID", "Target(s): " .. targetNamesStr, Theme.Success)
            setFloatingStopButton("void", "🛑 STOP VOID", true, function() runCommand("unvoid") end)
        else showNotification("❌ ERROR", "No valid targets.", Theme.Danger) end
    elseif cmdName == "unvoid" then
        commandVoidLooping = false; activeVoidTargets = {}
        setFloatingStopButton("void", "", false)
        showNotification("🛑 STOPPED", "Void sequence disabled.", Theme.Danger)
    elseif cmdName == "kill" then
        if #newTargets > 0 then
            activeKillTargets = newTargets; commandKillLooping = true
