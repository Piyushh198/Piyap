Players.PlayerRemoving:Connect(function(player)
    local isTargetOfSomething = false
    local function checkList(lst)
        for _, item in ipairs(lst) do
            local id = type(item) == "table" and item.targetId or item
            if id == player.UserId then isTargetOfSomething = true end
        end
    end
    checkList(activeHitTargets); checkList(activeGlitchTargets)
    checkList(activeVoidTargets); checkList(activeKillTargets); checkList(activeTrapTargets)
    checkList(activeCamLockTargets); checkList(activeGlueTargets)

    if isTargetOfSomething then
        showNotification("🏃 TARGET LEFT", player.DisplayName .. " disconnected!", Theme.Danger)
    end
end)

