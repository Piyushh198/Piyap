local dragToggle, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragToggle = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragToggle then
        local delta = input.Position - dragStart
        tween(MainFrame, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.15, Enum.EasingStyle.Linear)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragToggle = false
    end
end)

local clicking = false
local clickConnection
local activeGlowTween
local targetX, targetY = 0, 0
local positionSet = false

local function toggleAutoClicker()
    clicking = not clicking
    
    if clicking then
        if not positionSet then
            local mousePos = UserInputService:GetMouseLocation()
            targetX, targetY = mousePos.X, mousePos.Y
        end
        
        StatusLabel.Text = "ON [K]"
        tween(StatusLabel, {BackgroundColor3 = Color3.fromRGB(18, 35, 22), TextColor3 = Color3.fromRGB(70, 255, 100)}, 0.3)
        tween(UIStroke, {Color = Color3.fromRGB(0, 200, 255), Thickness = 2}, 0.3)
        
        activeGlowTween = TweenService:Create(Glow, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {ImageTransparency = 0.5})
        activeGlowTween:Play()
        
        local cps = tonumber(CPSInput.Text) or 100
        local accumulatedTime = 0
        
        clickConnection = RunService.Heartbeat:Connect(function(deltaTime)
            accumulatedTime += (cps * deltaTime)
            while accumulatedTime >= 1 do
                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
                VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
                accumulatedTime -= 1
            end
        end)
    else
        StatusLabel.Text = "OFF [K]"
        tween(StatusLabel, {BackgroundColor3 = Color3.fromRGB(35, 18, 22), TextColor3 = Color3.fromRGB(255, 70, 70)}, 0.3)
        tween(UIStroke, {Color = Color3.fromRGB(50, 50, 70), Thickness = 1.5}, 0.3)
        
        if activeGlowTween then activeGlowTween:Cancel() end
        tween(Glow, {ImageTransparency = 1}, 0.5)
        
        if clickConnection then
            clickConnection:Disconnect()
            clickConnection = nil
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.K then
        tween(MainFrame, {Size = UDim2.new(0, 235, 0, 185)}, 0.08, Enum.EasingStyle.Sine)
        task.delay(0.08, function() tween(MainFrame, {Size = UDim2.new(0, 250, 0, 195)}, 0.2, Enum.EasingStyle.Back) end)
        toggleAutoClicker()
        
    elseif input.KeyCode == Enum.KeyCode.P then
        local mousePos = UserInputService:GetMouseLocation()
        targetX, targetY = mousePos.X, mousePos.Y
        positionSet = true
        PosLabel.Text = string.format("Set: %d, %d", targetX, targetY)
        
        tween(PosLabel, {TextColor3 = Color3.fromRGB(0, 220, 255)}, 0.1)
        task.delay(0.2, function() tween(PosLabel, {TextColor3 = Color3.fromRGB(160, 160, 180)}, 0.3) end)
        
        tween(MainFrame, {Rotation = 2}, 0.05)
        task.delay(0.05, function() tween(MainFrame, {Rotation = 0}, 0.15) end)
    end
end)

