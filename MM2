local openDragging, openDragInput, openDragStart, openStartPos
local isGuiOpen = false
local hasDraggedOpen = false

addConn(OpenButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		openDragging = true
		hasDraggedOpen = false
		openDragStart = input.Position
		openStartPos = OpenButton.Position
		local endConn
		endConn = addConn(input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then 
				openDragging = false
				if endConn then endConn:Disconnect() end
			end
		end))
	end
end))

addConn(OpenButton.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then openDragInput = input end
end))

addConn(UserInputService.InputChanged:Connect(function(input)
	if input == openDragInput and openDragging then
		local delta = input.Position - openDragStart
		if delta.Magnitude > 3 then hasDraggedOpen = true end
		local targetPos = UDim2.new(openStartPos.X.Scale, openStartPos.X.Offset + delta.X, openStartPos.Y.Scale, openStartPos.Y.Offset + delta.Y)
		TweenService:Create(OpenButton, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {Position = targetPos}):Play()
	end
end))

addConn(OpenButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if not hasDraggedOpen then
			isGuiOpen = not isGuiOpen
			if isGuiOpen then
				MainFrame.Visible = true
				MainFrame.Size = UDim2.new(0, 450, 0, 315)
				MainFrame.Position = UDim2.new(0.5, -225, 0.5, -157)
				createTween(MainFrame, {GroupTransparency = 0, Size = UDim2.new(0, 500, 0, 350), Position = UDim2.new(0.5, -250, 0.5, -175)}, 0.5)
			else
				local closeTween = createTween(MainFrame, {GroupTransparency = 1, Size = UDim2.new(0, 450, 0, 315), Position = UDim2.new(0.5, -225, 0.5, -157)}, 0.4)
				closeTween.Completed:Once(function() if not isGuiOpen then MainFrame.Visible = false end end)
			end
		end
	end
end))

