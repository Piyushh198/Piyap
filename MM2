-- LINE OF SIGHT KNIFE THROWER (SCANS WHOLE MAP)
local function autoKnifeThrow()
	if findMurderer() ~= LocalPlayer then return end
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("PrimaryPart") then return end
	local knife = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
	if not knife then return end
	
	local sightOrigin = char:FindFirstChild("Head") and char.Head.Position or char.PrimaryPart.Position
	
	local bestTarget = nil
	local shortestDist = math.huge
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local targetHRP = p.Character.HumanoidRootPart
				local dist = (sightOrigin - targetHRP.Position).Magnitude
				
				if dist < shortestDist then
					local ignoreList = {char, p.Character, workspace.CurrentCamera}
					if checkLineOfSight(sightOrigin, targetHRP.Position, ignoreList) then
						shortestDist = dist
						bestTarget = p
					end
				end
			end
		end
	end
	
	if bestTarget then
		if knife.Parent ~= char then
			char.Humanoid:EquipTool(knife)
			task.wait(0.05)
		end
		
		local throwOrigin = char:FindFirstChild("RightHand") and char.RightHand.Position or char.PrimaryPart.Position
		local predictedPos = getPredictedPosition(bestTarget, ShootOffset + 1)
		
		pcall(function()
			local events = knife:FindFirstChild("Events")
			if events and events:FindFirstChild("KnifeThrown") then
				events.KnifeThrown:FireServer(CFrame.new(throwOrigin), CFrame.new(predictedPos))
			elseif knife:FindFirstChild("Throw") then
				knife.Throw:FireServer(CFrame.new(throwOrigin), CFrame.new(predictedPos))
			end
		end)
	end
end

