-- CUSTOM LINE OF SIGHT SCANNER
local function checkLineOfSight(originPos, targetPos, ignoreList)
	local direction = targetPos - originPos
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = ignoreList
	
	local hit = workspace:Raycast(originPos, direction, raycastParams)
	if hit then
		-- Ignore transparent parts, non-collidable parts, and glass
		if hit.Instance.Transparency >= 0.5 or not hit.Instance.CanCollide or hit.Instance.Name == "Glass" then
			table.insert(ignoreList, hit.Instance)
			return checkLineOfSight(originPos, targetPos, ignoreList)
		end
		-- It hit a solid opaque wall
		return false
	end
	-- Hit nothing, meaning clear line of sight!
	return true
end

