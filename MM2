local MultiFlingLabel = Instance.new("TextLabel")
MultiFlingLabel.Parent = FlingPage
MultiFlingLabel.BackgroundTransparency = 1
MultiFlingLabel.Size = UDim2.new(1, 0, 0, 25)
MultiFlingLabel.Font = Enum.Font.GothamBold
MultiFlingLabel.Text = "MULTI-TARGET FLING"
MultiFlingLabel.TextColor3 = Color3.fromRGB(100, 170, 255)
MultiFlingLabel.TextSize = 16

local SelectedTargets = {}

local function StartMultiFling()
	if getgenv().FlingActive then return end
	local count = 0
	for _ in pairs(SelectedTargets) do count = count + 1 end
	if count == 0 then
		sendNotification("Error", "No targets selected!", 3)
		return
	end
	
	getgenv().FlingActive = true
	sendNotification("Fling", "Flinging " .. count .. " target(s)", 3)
	
	task.spawn(function()
		while getgenv().FlingActive and getgenv().PiyapRunning do
			local validTargets = {}
			for name, player in pairs(SelectedTargets) do
				if player and player.Parent then
					validTargets[name] = player
				else
					SelectedTargets[name] = nil
				end
			end
			
			for _, player in pairs(validTargets) do
				if getgenv().FlingActive then
					SkidFling(player, true)
					task.wait(0.1)
				else break end
			end
			task.wait(0.5)
		end
	end)
end

local function StopMultiFling()
	if not getgenv().FlingActive then return end
	getgenv().FlingActive = false
	sendNotification("Fling", "Multi-Fling stopped.", 3)
end

createButton(FlingPage, "Start Multi-Fling", StartMultiFling)
createButton(FlingPage, "Stop Multi-Fling", StopMultiFling)

local PlayerContainer = Instance.new("Frame")
PlayerContainer.Name = "PlayerContainer"
PlayerContainer.BackgroundTransparency = 1
PlayerContainer.Size = UDim2.new(1, 0, 0, 0)
PlayerContainer.AutomaticSize = Enum.AutomaticSize.Y
PlayerContainer.Parent = FlingPage

local PCLayout = Instance.new("UIListLayout")
PCLayout.SortOrder = Enum.SortOrder.LayoutOrder
PCLayout.Padding = UDim.new(0, 10)
PCLayout.Parent = PlayerContainer

local function RefreshPlayerList()
	for _, child in pairs(PlayerContainer:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	
	local pList = Players:GetPlayers()
	table.sort(pList, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
	
	for _, player in ipairs(pList) do
		if player ~= LocalPlayer then
			local isSelected = SelectedTargets[player.Name] ~= nil
			createToggle(PlayerContainer, player.DisplayName, isSelected, function(state)
				if state then
					SelectedTargets[player.Name] = player
				else
					SelectedTargets[player.Name] = nil
				end
			end)
		end
	end
end

local function ToggleAllPlayers(select)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			SelectedTargets[player.Name] = select and player or nil
		end
	end
	RefreshPlayerList()
end

createButton(FlingPage, "Select All", function() ToggleAllPlayers(true) end)
createButton(FlingPage, "Deselect All", function() ToggleAllPlayers(false) end)

addConn(Players.PlayerAdded:Connect(function() task.wait(1) RefreshPlayerList() end))
addConn(Players.PlayerRemoving:Connect(function(player)
	SelectedTargets[player.Name] = nil
	RefreshPlayerList()
end))

RefreshPlayerList()

