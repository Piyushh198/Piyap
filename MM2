	local TabPage = Instance.new("CanvasGroup")
	TabPage.Parent = TabContainer
	TabPage.BackgroundTransparency = 1
	TabPage.Size = UDim2.new(1, 0, 1, 0)
	TabPage.GroupTransparency = isFirst and 0 or 1
	TabPage.Visible = isFirst
	
	local ScrollFrame = Instance.new("ScrollingFrame")
	ScrollFrame.Parent = TabPage
	ScrollFrame.Size = UDim2.new(1, 0, 1, 0)
	ScrollFrame.BackgroundTransparency = 1
	ScrollFrame.ScrollBarThickness = 2
	ScrollFrame.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 65)
	ScrollFrame.BorderSizePixel = 0
	ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	
	local PageList = Instance.new("UIListLayout")
	PageList.Parent = ScrollFrame
	PageList.SortOrder = Enum.SortOrder.LayoutOrder
	PageList.Padding = UDim.new(0, 10)
	
	local PagePadding = Instance.new("UIPadding")
	PagePadding.Parent = ScrollFrame
	PagePadding.PaddingTop = UDim.new(0, 15)
	PagePadding.PaddingLeft = UDim.new(0, 15)
	PagePadding.PaddingRight = UDim.new(0, 15)
	PagePadding.PaddingBottom = UDim.new(0, 15)
	
	addConn(PageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 30)
	end))
	
	if isFirst then activePage = TabPage end
	table.insert(tabs, TabButton)
	table.insert(pages, TabPage)
	
	addConn(TabButton.MouseButton1Click:Connect(function()
		if activePage == TabPage then return end
		for i, v in pairs(tabs) do
			createTween(v, {BackgroundColor3 = Color3.fromRGB(25, 25, 28), TextColor3 = Color3.fromRGB(150, 150, 150)}, 0.3)
		end
		createTween(TabButton, {BackgroundColor3 = Color3.fromRGB(45, 45, 52), TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.3)
		
		if activePage then
			local oldPage = activePage
			local fadeOut = createTween(oldPage, {GroupTransparency = 1, Position = UDim2.new(0, -20, 0, 0)}, 0.25)
			fadeOut.Completed:Once(function() oldPage.Visible = false end)
		end
		
		TabPage.Visible = true
		TabPage.Position = UDim2.new(0, 20, 0, 0)
		createTween(TabPage, {GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0)}, 0.35)
		activePage = TabPage
	end))
	
	return ScrollFrame
end

