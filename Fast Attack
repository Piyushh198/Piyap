--========================================================================
-- INPUT HANDLING
--========================================================================
addConn(UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.Semicolon then
        openCmdBar()
    end

    if not gpe and input.KeyCode.Name == string.upper(_G.PiyapSettings.FlyKey) then
        toggleFly()
    end

    if gpe then return end
    
    if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = true
    elseif input.KeyCode == Enum.KeyCode.S then FlyKeys.S = true
    elseif input.KeyCode == Enum.KeyCode.A then FlyKeys.A = true
    elseif input.KeyCode == Enum.KeyCode.D then FlyKeys.D = true
    elseif input.KeyCode == Enum.KeyCode.Space then FlyKeys.Space = true
    elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then FlyKeys.Control = true
    end
end))

addConn(UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = false
    elseif input.KeyCode == Enum.KeyCode.S then FlyKeys.S = false
    elseif input.KeyCode == Enum.KeyCode.A then FlyKeys.A = false
    elseif input.KeyCode == Enum.KeyCode.D then FlyKeys.D = false
    elseif input.KeyCode == Enum.KeyCode.Space then FlyKeys.Space = false
    elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then FlyKeys.Control = false
    end
end))

--========================================================================
-- COMMAND LOGIC
--========================================================================
addConn(CmdBar.FocusLost:Connect(function(enterPressed)
    CmdBar.Visible = false 
    if enterPressed then
        local text = CmdBar.Text
        CmdBar.Text = "" 
        if text:sub(1, 1) == ";" then text = text:sub(2) end
        
        local args = string.split(text, " ")
        local cmd = string.lower(args[1])
        
        if cmd == "tween" or cmd == "t" then
            local p = getPlayer(args[2])
            if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                startMovement(p.Character.HumanoidRootPart.CFrame, nil, false)
            end
        elseif cmd == "dark" then
            local darkCFrame = CFrame.new(3708.594970703125, 14.87232494354248, -3494.147705078125)
            startMovement(darkCFrame, nil, false)
        elseif cmd == "core" then
            local coreCFrame = CFrame.new(429.5496826171875, 211.65948486328125, -430.6715393066406)
            startMovement(coreCFrame, nil, false)
        elseif cmd == "kill" or cmd == "k" then
            local p = getPlayer(args[2])
            if p then startOrbit(p) end
        elseif cmd == "killspeed" or cmd == "ksp" then
            local spd = tonumber(args[2])
            if spd then 
                _G.PiyapSettings.KillSpeed = spd 
                saveSettings()
                sendNotification("Piyap Hub", "Kill Speed set to " .. spd, 3)
            end
        elseif cmd == "tweenspeed" then
            local spd = tonumber(args[2])
            if spd then 
                _G.PiyapSettings.TweenSpeed = spd 
                saveSettings()
                sendNotification("Piyap Hub", "Tween Speed set to " .. spd, 3)
            end
        elseif cmd == "looptween" or cmd == "ltween" then
            local p = getPlayer(args[2])
            if p then startMovement(nil, p, false) end
        elseif cmd == "hunt" or cmd == "h" then
            local p = getPlayer(args[2])
            if p then startMovement(nil, p, true) end
        elseif cmd == "fa" or cmd == "fastattack" then
            _G.PiyapSettings.FastAttack = not _G.PiyapSettings.FastAttack
            saveSettings()
            sendNotification("Piyap Hub", "Fast Attack: " .. (_G.PiyapSettings.FastAttack and "ON" or "OFF"), 3)
        elseif cmd == "re" then
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        elseif cmd == "stop" or cmd == "s" then
            stopMovement()
        elseif cmd == "flykey" then
            local newKey = args[2]
            if newKey then
                _G.PiyapSettings.FlyKey = string.upper(newKey)
                saveSettings()
                sendNotification("Piyap Hub", "Fly Key set to " .. string.upper(newKey), 3)
            end
        elseif cmd == "flyspeed" then
            local spd = tonumber(args[2])
            if spd then 
                _G.PiyapSettings.FlySpeed = spd 
                saveSettings()
                sendNotification("Piyap Hub", "Fly Speed set to " .. spd, 3)
            end
        elseif cmd == "cmds" then
            sendNotification("Piyap Hub Commands", "t/tween, dark, core, kill/k, killspeed\nltween, hunt, tweenspeed, fa\nflykey, flyspeed, re, stop/s", 10)
        end
    end
end))

