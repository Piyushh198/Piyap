local function openCmdBar()
    CmdBar.Visible = true
    CmdBar.Text = ""
    task.wait() 
    CmdBar:CaptureFocus()
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.Semicolon then
        openCmdBar()
    end
end)

CmdBar.FocusLost:Connect(function(enterPressed)
    CmdBar.Visible = false 
    
    if enterPressed then
        local text = CmdBar.Text
        CmdBar.Text = "" 
        
        if text:sub(1, 1) == ";" then text = text:sub(2) end
        
        local args = string.split(text, " ")
        local cmd = string.lower(args[1])
        
        if cmd == "tween" or cmd == "t" then
            if args[2] and string.lower(args[2]) == "dark" then
                local darkCFrame = CFrame.new(3708.594970703125, 14.87232494354248, -3494.147705078125)
                startMovement(darkCFrame, nil, false)
            else
                local p = getPlayer(args[2])
                if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    startMovement(p.Character.HumanoidRootPart.CFrame, nil, false)
                end
            end
        elseif cmd == "up" then
            startUpwardMovement()
        elseif cmd == "tweenspeed" then
            local spd = tonumber(args[2])
            if spd then 
                _G.TweenSpeed = spd 
                StarterGui:SetCore("SendNotification", {Title = "Piyap Hub", Text = "Tween Speed set to " .. spd, Duration = 3})
            end
        elseif cmd == "looptween" or cmd == "ltween" then
            local p = getPlayer(args[2])
            if p then
                startMovement(nil, p, false)
            end
        elseif cmd == "hunt" or cmd == "h" then
            local p = getPlayer(args[2])
            if p then
                startMovement(nil, p, true)
            end
        elseif cmd == "re" then
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        elseif cmd == "stop" then
            stopMovement()
            if isProtecting then
                manualOverride = true -- Allow the user to force-stop protection evasion
                isProtecting = false
            end
        elseif cmd == "cmds" then
            StarterGui:SetCore("SendNotification", {
                Title = "Piyap Hub Commands",
                Text = "t/tween [plr]\nt dark\nup\nltween [plr]\nhunt [plr]\ntweenspeed [num]\nre\nstop\ncmds",
                Duration = 8
            })
        end
    end
end)

