    end
end

local function toggleFreecam()
    isFreecam = not isFreecam
    local cam = Workspace.CurrentCamera
    if isFreecam then
        cam.CameraType = Enum.CameraType.Scriptable
        local currentCFrame = cam.CFrame
        local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = currentCFrame:GetComponents()
        -- Extract initial angles
        fcYaw = math.atan2(-r02, -r22)
        fcPitch = math.asin(r12)
        
        fcConn = RunService.RenderStepped:Connect(function(dt)
            local mouseDelta = UserInputService:GetMouseDelta()
            fcYaw -= mouseDelta.X * 0.003
            fcPitch = math.clamp(fcPitch - mouseDelta.Y * 0.003, -math.rad(89), math.rad(89))
            
            local rotCF = CFrame.Angles(0, fcYaw, 0) * CFrame.Angles(fcPitch, 0, 0)
            local dir = Vector3.zero
            if FlyKeys.W then dir += Vector3.new(0,0,-1) end 
            if FlyKeys.S then dir += Vector3.new(0,0,1) end 
            if FlyKeys.D then dir += Vector3.new(1,0,0) end 
            if FlyKeys.A then dir += Vector3.new(-1,0,0) end 
            if FlyKeys.Space then dir += Vector3.new(0,1,0) end 
            if FlyKeys.Control then dir += Vector3.new(0,-1,0) end
            
            if dir.Magnitude > 0 then
                currentCFrame = currentCFrame + (rotCF:VectorToWorldSpace(dir.Unit) * _G.PiyapSettings.FlySpeed * dt)
            end
            cam.CFrame = CFrame.new(currentCFrame.Position) * rotCF
        end)
        addConn(fcConn)
    else
        if fcConn then fcConn:Disconnect() fcConn = nil end
        cam.CameraType = Enum.CameraType.Custom
        cam.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    end
end

local function toggleFly()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not isFlying then
        if flyConn then flyConn:Disconnect() flyConn = nil end
        if root then if root:FindFirstChild("PiyapFlyVelocity") then root.PiyapFlyVelocity:Destroy() end if root:FindFirstChild("PiyapFlyGyro") then root.PiyapFlyGyro:Destroy() end end
        return
    end
    if not root then return end
    local bv = Instance.new("BodyVelocity", root) bv.Name = "PiyapFlyVelocity" bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    local bg = Instance.new("BodyGyro", root) bg.Name = "PiyapFlyGyro" bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge) bg.P = 15000
    local Cam = Workspace.CurrentCamera
    flyConn = RunService.RenderStepped:Connect(function()
        if not isFlying then return end
        local cRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not cRoot then return end
        if bv.Parent ~= cRoot then bv.Parent = cRoot end if bg.Parent ~= cRoot then bg.Parent = cRoot end
        for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
        bg.CFrame = Cam.CFrame
        local dir = Vector3.zero
        if FlyKeys.W then dir += Cam.CFrame.LookVector end if FlyKeys.S then dir -= Cam.CFrame.LookVector end
        if FlyKeys.D then dir += Cam.CFrame.RightVector end if FlyKeys.A then dir -= Cam.CFrame.RightVector end
        if FlyKeys.Space then dir += Vector3.new(0,1,0) end if FlyKeys.Control then dir -= Vector3.new(0,1,0) end
        if dir.Magnitude > 0 then bv.Velocity = dir.Unit * math.clamp(_G.PiyapSettings.FlySpeed, 20, 1000) else bv.Velocity = Vector3.zero end
    end)
    addConn(flyConn)
end

