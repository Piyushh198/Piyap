local function startMovement(targetCFrame, targetPlayer, hunting, isOrbit, isUp)
    stopMovement()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if isOrbit then _G.OrbitTarget = targetPlayer elseif targetPlayer then _G.LoopTweenTarget = targetPlayer end
    isHuntingMode = hunting
    antiFallBv = Instance.new("BodyVelocity", hrp) antiFallBv.Name = "AntiFallBv" antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge) antiFallBv.Velocity = Vector3.zero
    enableNoclip()

    moveConn = RunService.Heartbeat:Connect(function(dt)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then stopMovement() return end
        
        if isUp then
            myHrp.CFrame = myHrp.CFrame + Vector3.new(0, _G.PiyapSettings.TweenSpeed * dt, 0)
            return
        end
        
        local targetPos
        if isOrbit and _G.OrbitTarget then
            local tHrp = _G.OrbitTarget.Character and _G.OrbitTarget.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local t = tick() * 4
                targetPos = tHrp.Position + Vector3.new(math.cos(t)*(40+math.sin(t/2)*10), math.sin(t*1.5)*30, math.sin(t)*(40+math.sin(t/2)*10))
            else stopMovement() return end
        elseif _G.LoopTweenTarget then
            local tHum = _G.LoopTweenTarget.Character and _G.LoopTweenTarget.Character:FindFirstChildOfClass("Humanoid")
            local tHrp = _G.LoopTweenTarget.Character and _G.LoopTweenTarget.Character:FindFirstChild("HumanoidRootPart")
            if isHuntingMode and tHum and tHum.Health <= 0 then sendNotification("Piyap Hub", "Target eliminated.", 4) stopMovement() return end
            if tHrp then targetPos = tHrp.Position else stopMovement() return end
        else
            targetPos = targetCFrame.Position
        end

        local dir = (targetPos - myHrp.Position)
        local dist = dir.Magnitude
        local spd = isOrbit and _G.PiyapSettings.KillSpeed or _G.PiyapSettings.TweenSpeed
        if dist > 3 then
            local step = spd * dt
            if step > dist then step = dist end
            myHrp.CFrame = CFrame.lookAt(myHrp.Position + dir.Unit * step, targetPos)
        else
            if not _G.LoopTweenTarget and not isOrbit then stopMovement() end
        end
    end)
    addConn(moveConn)
end

local function getPlayer(str)
    if not str then return nil end str = string.lower(str)
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and (string.sub(string.lower(p.Name), 1, #str) == str or string.sub(string.lower(p.DisplayName), 1, #str) == str) then return p end end
    return nil
end

