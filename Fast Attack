-- CHEST FARM SYSTEM
local function findNearestChest()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closestChest = nil
    local shortestDist = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Chest1" or obj.Name == "Chest2" or obj.Name == "Chest3") then
            if obj.Parent and obj:FindFirstChildOfClass("TouchTransmitter") then
                local dist = (obj.Position - myRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestChest = obj
                end
            end
        end
    end
    return closestChest
end

local function startChestFarm()
    stopMovement()
    _G.PiyapSettings.ChestFarm = true
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        antiFallBv = Instance.new("BodyVelocity", hrp)
        antiFallBv.Name = "AntiFallBv"
        antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        antiFallBv.Velocity = Vector3.zero
    end
    enableNoclip()

    local currentChest = nil
    chestConn = RunService.Heartbeat:Connect(function(dt)
        if not _G.PiyapSettings.ChestFarm then stopMovement() return end
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        if not antiFallBv or antiFallBv.Parent ~= myHrp then
            if antiFallBv then antiFallBv:Destroy() end
            antiFallBv = Instance.new("BodyVelocity", myHrp)
            antiFallBv.Name = "AntiFallBv"
            antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            antiFallBv.Velocity = Vector3.zero
        end

        if not currentChest or not currentChest.Parent or not currentChest:FindFirstChildOfClass("TouchTransmitter") then
            currentChest = findNearestChest()
        end

        if currentChest then
            local targetPos = currentChest.Position
            local dir = (targetPos - myHrp.Position)
            local dist = dir.Magnitude
            if dist > 2 then
                local step = _G.PiyapSettings.TweenSpeed * dt
                if step > dist then step = dist end
                myHrp.CFrame = CFrame.lookAt(myHrp.Position + dir.Unit * step, targetPos)
            else
                myHrp.CFrame = currentChest.CFrame
                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(myHrp, currentChest, 0)
                        firetouchinterest(myHrp, currentChest, 1)
                    end)
                end
                currentChest = nil
            end
        end
