        if hrp:FindFirstChild("AntiFallBv") then hrp.AntiFallBv:Destroy() end
        hrp.Anchored = false
    end
end)

pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Piyap Hub",
        Text = "Loaded successfully. Press ';' for commands.",
        Duration = 5,
        Icon = "rbxassetid://6023426923"
    })
end)

