-- SETTINGS & AUTO-SAVE
--========================================================================
local settingsFile = "PiyapHub_Settings.json"
_G.PiyapSettings = _G.PiyapSettings or {
    FlyKey = "P",
    FlySpeed = 120,
    TweenSpeed = 200
}

local function saveSettings()
    pcall(function()
        if writefile then
            writefile(settingsFile, HttpService:JSONEncode(_G.PiyapSettings))
        end
    end)
end

pcall(function()
    if isfile and isfile(settingsFile) then
        local data = readfile(settingsFile)
        local parsed = HttpService:JSONDecode(data)
        if parsed then
            for k, v in pairs(parsed) do
                _G.PiyapSettings[k] = v
            end
        end
    end
end)

--========================================================================
-- FRIEND CACHE
--========================================================================
local friendCache = {}
local function cacheFriends()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            task.spawn(function()
                pcall(function() friendCache[p.UserId] = LocalPlayer:IsFriendsWith(p.UserId) end)
            end)
        end
    end
end
cacheFriends()
addConn(Players.PlayerAdded:Connect(function(p)
    task.spawn(function()
        pcall(function() friendCache[p.UserId] = LocalPlayer:IsFriendsWith(p.UserId) end)
    end)
end))

--========================================================================
-- FAST ATTACK (ALWAYS ON)
--========================================================================
task.spawn(function()
    local Net = ReplicatedStorage:WaitForChild("Modules", 5) and ReplicatedStorage.Modules:WaitForChild("Net", 5)
    local RegisterAttack = Net and Net:WaitForChild("RE/RegisterAttack", 5)
    local RegisterHit = Net and Net:WaitForChild("RE/RegisterHit", 5)

    while task.wait(0.08) do
        if _G.PiyapHub_RunningId ~= CURRENT_RUN_ID then break end -- Kill old loop
        
        if RegisterAttack and RegisterHit then
            pcall(function()
                local char = LocalPlayer.Character
                local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end

                local targets = {}
                local primaryHit = nil

                local enemies = Workspace:FindFirstChild("Enemies")
                if enemies then
                    for _, mob in ipairs(enemies:GetChildren()) do
                        local hum = mob:FindFirstChildOfClass("Humanoid")
                        local head = mob:FindFirstChild("Head")
                        local root = mob:FindFirstChild("HumanoidRootPart")
                        if hum and head and root and hum.Health > 0 and (root.Position - myRoot.Position).Magnitude <= 200 then
                            table.insert(targets, {mob, head})
                            primaryHit = head
                        end
                    end
                end

                for _, other in ipairs(Players:GetPlayers()) do
                    if other ~= LocalPlayer and not friendCache[other.UserId] and other.Character then
                        local pHum = other.Character:FindFirstChildOfClass("Humanoid")
                        local pHead = other.Character:FindFirstChild("Head")
                        local pRoot = other.Character:FindFirstChild("HumanoidRootPart")
                        if pHum and pHead and pRoot and pHum.Health > 0 and (pRoot.Position - myRoot.Position).Magnitude <= 200 then
                            table.insert(targets, {other.Character, pHead})
                            primaryHit = pHead
                        end
                    end
                end

                if primaryHit and #targets > 0 then
                    RegisterAttack:FireServer(0)
                    RegisterHit:FireServer(primaryHit, targets)
                end
            end)
        end
    end
end)

--========================================================================
-- FLY SYSTEM
--========================================================================
local FlyKeys = {W = false, A = false, S = false, D = false, Space = false, Control = false}
local flyConn = nil
local isFlying = false

local function clearFlyMovement()
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            if root:FindFirstChild("PiyapFlyVelocity") then root.PiyapFlyVelocity:Destroy() end
            if root:FindFirstChild("PiyapFlyGyro") then root.PiyapFlyGyro:Destroy() end
        end
    end)
end

local function stopFly()
    isFlying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    clearFlyMovement()
end

local function startFly()
    stopFly()
    isFlying = true
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "PiyapFlyVelocity"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.Name = "PiyapFlyGyro"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 15000
    bg.CFrame = root.CFrame
    bg.Parent = root

    local Cam = Workspace.CurrentCamera
    flyConn = RunService.RenderStepped:Connect(function()
        if not isFlying then stopFly() return end

        local curChar = LocalPlayer.Character
        local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
        if not curRoot then return end

        if bv.Parent ~= curRoot then bv.Parent = curRoot end
        if bg.Parent ~= curRoot then bg.Parent = curRoot end

        for _, part in ipairs(curChar:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        bg.CFrame = Cam.CFrame

        local dir = Vector3.zero
        if FlyKeys.W then dir += Cam.CFrame.LookVector end
        if FlyKeys.S then dir -= Cam.CFrame.LookVector end
        if FlyKeys.D then dir += Cam.CFrame.RightVector end
        if FlyKeys.A then dir -= Cam.CFrame.RightVector end
        if FlyKeys.Space then dir += Vector3.new(0, 1, 0) end
        if FlyKeys.Control then dir -= Vector3.new(0, 1, 0) end

        if dir.Magnitude > 0 then
            bv.Velocity = dir.Unit * math.clamp(_G.PiyapSettings.FlySpeed, 20, 1000)
        else
            bv.Velocity = Vector3.zero
        end
    end)
    addConn(flyConn)
end

local function toggleFly()
    if isFlying then stopFly() else startFly() end
end

--========================================================================
-- TWEEN / MOVEMENT SYSTEM
--========================================================================
_G.LoopTweenTarget = nil

local noclipConn = nil
local moveConn = nil
local upMoveConn = nil
local antiFallBv = nil
local isHuntingMode = false

local isProtecting = false
local manualOverride = false

local function stopMovement()
    if moveConn then moveConn:Disconnect() moveConn = nil end
    if upMoveConn then upMoveConn:Disconnect() upMoveConn = nil end
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    if antiFallBv then antiFallBv:Destroy() antiFallBv = nil end
    _G.LoopTweenTarget = nil
    isHuntingMode = false
end

local function enableNoclip()
    if not noclipConn then
        noclipConn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
        addConn(noclipConn)
    end
end

local function startUpwardMovement()
    stopMovement()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    antiFallBv = Instance.new("BodyVelocity")
    antiFallBv.Name = "AntiFallBv"
    antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    antiFallBv.Velocity = Vector3.zero
    antiFallBv.Parent = hrp

    enableNoclip()

    upMoveConn = RunService.Heartbeat:Connect(function(dt)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then stopMovement() return end
        
        local step = _G.PiyapSettings.TweenSpeed * dt
        myHrp.CFrame = myHrp.CFrame + Vector3.new(0, step, 0)
    end)
    addConn(upMoveConn)
end

local function startMovement(targetCFrame, targetPlayer, hunting)
    stopMovement()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    _G.LoopTweenTarget = targetPlayer
    isHuntingMode = hunting

    antiFallBv = Instance.new("BodyVelocity")
    antiFallBv.Name = "AntiFallBv"
    antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    antiFallBv.Velocity = Vector3.zero
    antiFallBv.Parent = hrp

    enableNoclip()

    moveConn = RunService.Heartbeat:Connect(function(dt)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then stopMovement() return end

        local targetPos
        
        if _G.LoopTweenTarget then
            local tChar = _G.LoopTweenTarget.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            
            if isHuntingMode and tHum and tHum.Health <= 0 then
                StarterGui:SetCore("SendNotification", {Title = "Piyap Hub", Text = "Target eliminated. Hunt ended.", Duration = 4})
                stopMovement()
                return
            end
            
            if tHrp then targetPos = tHrp.Position
            else stopMovement() return end
        else
            targetPos = targetCFrame.Position
        end

        local dir = (targetPos - myHrp.Position)
        local dist = dir.Magnitude
        
        if dist > 3 then
            local step = _G.PiyapSettings.TweenSpeed * dt
            if step > dist then step = dist end
            myHrp.CFrame = CFrame.lookAt(myHrp.Position + dir.Unit * step, targetPos)
        else
            if not _G.LoopTweenTarget then stopMovement() end
        end
    end)
    addConn(moveConn)
end

-- Protection Loop
task.spawn(function()
    while task.wait(0.2) do
        if _G.PiyapHub_RunningId ~= CURRENT_RUN_ID then break end
        
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if hum and hum.Health > 0 then
            local pct = hum.Health / hum.MaxHealth
            if pct <= 0.10 then
                if not isProtecting and not manualOverride then
                    isProtecting = true
                    startUpwardMovement()
                    pcall(function() StarterGui:SetCore("SendNotification", {Title = "Protection Enabled", Text = "Health critical! Evading.", Duration = 3}) end)
                end
            elseif pct >= 0.50 then
                if isProtecting or manualOverride then
                    if isProtecting then
                        stopMovement()
                        pcall(function() StarterGui:SetCore("SendNotification", {Title = "Protection Disabled", Text = "Health recovered.", Duration = 3}) end)
                    end
                    isProtecting = false
                    manualOverride = false
                end
            end
        else
            isProtecting = false
            manualOverride = false
        end
    end
end)

local function getPlayer(str)
    if not str then return nil end
    str = string.lower(str)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.sub(string.lower(p.Name), 1, #str) == str or string.sub(string.lower(p.DisplayName), 1, #str) == str then
                return p
            end
        end
    end
    return nil
end

