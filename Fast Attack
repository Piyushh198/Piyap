--========================================================================
-- FLY SYSTEM
--========================================================================
local FlyKeys = {W = false, A = false, S = false, D = false, Space = false, Control = false}
local flyConn = nil
local isFlying = false

local function clearFlyMovement()
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            if root:FindFirstChild("PiyapFlyVelocity") then root.PiyapFlyVelocity:Destroy() end
            if root:FindFirstChild("PiyapFlyGyro") then root.PiyapFlyGyro:Destroy() end
        end
    end)
end

local function stopFly()
    isFlying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    clearFlyMovement()
end

local function startFly()
    stopFly()
    isFlying = true
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "PiyapFlyVelocity"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local bg = Instance.new("BodyGyro")
    bg.Name = "PiyapFlyGyro"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 15000
    bg.CFrame = root.CFrame
    bg.Parent = root

    local Cam = Workspace.CurrentCamera
    flyConn = RunService.RenderStepped:Connect(function()
        if not isFlying then stopFly() return end

        local curChar = LocalPlayer.Character
        local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
        if not curRoot then return end

        if bv.Parent ~= curRoot then bv.Parent = curRoot end
        if bg.Parent ~= curRoot then bg.Parent = curRoot end

        for _, part in ipairs(curChar:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        bg.CFrame = Cam.CFrame
        local dir = Vector3.zero
        if FlyKeys.W then dir += Cam.CFrame.LookVector end
        if FlyKeys.S then dir -= Cam.CFrame.LookVector end
        if FlyKeys.D then dir += Cam.CFrame.RightVector end
        if FlyKeys.A then dir -= Cam.CFrame.RightVector end
        if FlyKeys.Space then dir += Vector3.new(0, 1, 0) end
        if FlyKeys.Control then dir -= Vector3.new(0, 1, 0) end

        if dir.Magnitude > 0 then
            bv.Velocity = dir.Unit * math.clamp(_G.PiyapSettings.FlySpeed, 20, 1000)
        else
            bv.Velocity = Vector3.zero
        end
    end)
    addConn(flyConn)
end

local function toggleFly()
    if isFlying then stopFly() else startFly() end
end

--========================================================================
-- TWEEN & KILL ORBIT SYSTEM
--========================================================================
_G.LoopTweenTarget = nil
_G.OrbitTarget = nil

local noclipConn = nil
local moveConn = nil
local upMoveConn = nil
local antiFallBv = nil
local isHuntingMode = false

local function stopMovement()
    if moveConn then moveConn:Disconnect() moveConn = nil end
    if upMoveConn then upMoveConn:Disconnect() upMoveConn = nil end
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    if antiFallBv then antiFallBv:Destroy() antiFallBv = nil end
    _G.LoopTweenTarget = nil
    _G.OrbitTarget = nil
    isHuntingMode = false
end

local function enableNoclip()
    if not noclipConn then
        noclipConn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
        addConn(noclipConn)
    end
end

local function startUpwardMovement()
    stopMovement()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    antiFallBv = Instance.new("BodyVelocity")
    antiFallBv.Name = "AntiFallBv"
    antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    antiFallBv.Velocity = Vector3.zero
    antiFallBv.Parent = hrp

    enableNoclip()

    upMoveConn = RunService.Heartbeat:Connect(function(dt)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then stopMovement() return end
        
        local step = _G.PiyapSettings.TweenSpeed * dt
        myHrp.CFrame = myHrp.CFrame + Vector3.new(0, step, 0)
    end)
    addConn(upMoveConn)
end

local function startOrbit(targetPlayer)
    stopMovement()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    _G.OrbitTarget = targetPlayer
    antiFallBv = Instance.new("BodyVelocity")
    antiFallBv.Name = "AntiFallBv"
    antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    antiFallBv.Velocity = Vector3.zero
    antiFallBv.Parent = hrp

    enableNoclip()

    moveConn = RunService.Heartbeat:Connect(function(dt)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then stopMovement() return end

        local tChar = _G.OrbitTarget and _G.OrbitTarget.Character
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        
        if tHrp then
            local t = tick()
            local orbitTime = t * 4 
            local orbitRadius = 40 + math.sin(t * 2) * 10 
            
            local offsetX = math.cos(orbitTime) * orbitRadius
            local offsetZ = math.sin(orbitTime) * orbitRadius
            local offsetY = math.sin(orbitTime * 1.5) * (orbitRadius * 0.8)
            
            local targetPos = tHrp.Position + Vector3.new(offsetX, offsetY, offsetZ)
            local dir = (targetPos - myHrp.Position)
            local dist = dir.Magnitude
            
            local step = _G.PiyapSettings.KillSpeed * dt 
            if step > dist then step = dist end
            
            myHrp.CFrame = CFrame.lookAt(myHrp.Position + dir.Unit * step, tHrp.Position)
        else
            stopMovement()
        end
    end)
    addConn(moveConn)
end

local function startMovement(targetCFrame, targetPlayer, hunting)
    stopMovement()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    _G.LoopTweenTarget = targetPlayer
    isHuntingMode = hunting

    antiFallBv = Instance.new("BodyVelocity")
    antiFallBv.Name = "AntiFallBv"
    antiFallBv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    antiFallBv.Velocity = Vector3.zero
    antiFallBv.Parent = hrp

    enableNoclip()

    moveConn = RunService.Heartbeat:Connect(function(dt)
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then stopMovement() return end

        local targetPos
        
        if _G.LoopTweenTarget then
            local tChar = _G.LoopTweenTarget.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
            
            if isHuntingMode and tHum and tHum.Health <= 0 then
                sendNotification("Piyap Hub", "Target eliminated. Hunt ended.", 4)
                stopMovement()
                return
            end
            
            if tHrp then targetPos = tHrp.Position
            else stopMovement() return end
        else
            targetPos = targetCFrame.Position
        end

        local dir = (targetPos - myHrp.Position)
        local dist = dir.Magnitude
        
        if dist > 3 then
            local step = _G.PiyapSettings.TweenSpeed * dt
            if step > dist then step = dist end
            myHrp.CFrame = CFrame.lookAt(myHrp.Position + dir.Unit * step, targetPos)
        else
            if not _G.LoopTweenTarget then stopMovement() end
        end
    end)
    addConn(moveConn)
end

local function getPlayer(str)
    if not str then return nil end
    str = string.lower(str)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.sub(string.lower(p.Name), 1, #str) == str or string.sub(string.lower(p.DisplayName), 1, #str) == str then
                return p
            end
        end
    end
    return nil
end

--========================================================================
-- COMMAND EXECUTOR (CENTRALIZED)
--========================================================================
local KeybindGui

local function executeCommand(text)
    local args = string.split(string.lower(text), " ")
    local cmd = args[1]
    
    if cmd == "tween" or cmd == "t" then
        local p = getPlayer(args[2])
        if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            startMovement(p.Character.HumanoidRootPart.CFrame, nil, false)
        end
    elseif cmd == "dark" then
        local darkCFrame = CFrame.new(3708.594970703125, 14.87232494354248, -3494.147705078125)
        startMovement(darkCFrame, nil, false)
    elseif cmd == "core" then
        local coreCFrame = CFrame.new(429.5496826171875, 211.65948486328125, -430.6715393066406)
        startMovement(coreCFrame, nil, false)
    elseif cmd == "up" then
        startUpwardMovement()
    elseif cmd == "kill" or cmd == "k" then
        local p = getPlayer(args[2])
        if p then startOrbit(p) end
    elseif cmd == "killspeed" or cmd == "ksp" then
        local spd = tonumber(args[2])
        if spd then 
            _G.PiyapSettings.KillSpeed = spd 
            saveSettings()
            sendNotification("Piyap Hub", "Kill Speed set to " .. spd, 3)
        end
    elseif cmd == "tweenspeed" then
        local spd = tonumber(args[2])
        if spd then 
            _G.PiyapSettings.TweenSpeed = spd 
            saveSettings()
            sendNotification("Piyap Hub", "Tween Speed set to " .. spd, 3)
        end
    elseif cmd == "looptween" or cmd == "ltween" then
        local p = getPlayer(args[2])
        if p then startMovement(nil, p, false) end
    elseif cmd == "hunt" or cmd == "h" then
        local p = getPlayer(args[2])
        if p then startMovement(nil, p, true) end
    elseif cmd == "fa" or cmd == "fastattack" then
        _G.PiyapSettings.FastAttack = not _G.PiyapSettings.FastAttack
        saveSettings()
        sendNotification("Piyap Hub", "Fast Attack: " .. (_G.PiyapSettings.FastAttack and "ON" or "OFF"), 3)
    elseif cmd == "faspeed" then
        local spd = tonumber(args[2])
        if spd then
            _G.PiyapSettings.FaSpeed = spd
            saveSettings()
            sendNotification("Piyap Hub", "FA Speed set to " .. spd .. " CPS", 3)
        end
    elseif cmd == "q" then
        _G.PiyapSettings.AutoQ = not _G.PiyapSettings.AutoQ
        saveSettings()
        sendNotification("Piyap Hub", "Auto Q: " .. (_G.PiyapSettings.AutoQ and "ON" or "OFF"), 3)
        
        if not _G.PiyapSettings.AutoQ then
            pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game) end)
        end
    elseif cmd == "attackfriends" then
        _G.PiyapSettings.AttackFriends = not _G.PiyapSettings.AttackFriends
        saveSettings()
        sendNotification("Piyap Hub", "Attack Friends: " .. (_G.PiyapSettings.AttackFriends and "ON" or "OFF"), 3)
    elseif cmd == "fly" then
        toggleFly()
    elseif cmd == "flyspeed" then
        local spd = tonumber(args[2])
        if spd then 
            _G.PiyapSettings.FlySpeed = spd 
            saveSettings()
            sendNotification("Piyap Hub", "Fly Speed set to " .. spd, 3)
        end
    elseif cmd == "re" then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end
    elseif cmd == "stop" or cmd == "s" then
        stopMovement()
    elseif cmd == "keybind" or cmd == "binds" then
        KeybindGui.Enabled = not KeybindGui.Enabled
    elseif cmd == "cmds" then
        sendNotification("Piyap Hub Commands", "t/tween, dark, core, up, kill/k, killspeed\nltween, hunt, tweenspeed, fa, faspeed\nq, attackfriends, fly, flyspeed, re, stop/s\nkeybind", 10)
    end
end

