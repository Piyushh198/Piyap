--========================================================================
-- COMMAND EXECUTOR (TRUE SMART TOGGLE STATES)
--========================================================================
local function executeCommand(text, forcedState)
    local cleanText = string.lower(string.gsub(text, "^%s*(.-)%s*$", "%1"))
    local args = string.split(cleanText, " ")
    local cmd = args[1]

    if cmd == "auto" and args[2] == "q" then cmd = "q"
    elseif cmd == "auto" and args[2] == "w" then cmd = "autow" end
    
    if _G.PiyapSettings.Waypoints[cmd] then
        local wp = _G.PiyapSettings.Waypoints[cmd]
        startMovement(CFrame.new(wp.X, wp.Y, wp.Z), nil, false, false, false)
        sendNotification("Piyap Hub", "Tweening to waypoint: " .. cmd, 3)
    elseif cmd == "cf" or cmd == "chestfarm" then
        local newState = forcedState ~= nil and forcedState or not _G.PiyapSettings.ChestFarm
        if newState then startChestFarm() else stopMovement() end
        sendNotification("Piyap Hub", "Chest Farm: " .. (newState and "ON" or "OFF"), 3)
    elseif cmd == "pl" or cmd == "playerlist" then
        PlGui.Enabled = not PlGui.Enabled
        if PlGui.Enabled then refreshPlayerList() end
        sendNotification("Piyap Hub", "Player List GUI " .. (PlGui.Enabled and "Opened" or "Closed"), 3)
    elseif cmd == "tween" or cmd == "t" then
        local p = getPlayer(args[2])
        if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then 
            startMovement(p.Character.HumanoidRootPart.CFrame, nil, false, false, false) 
            sendNotification("Piyap Hub", "Tweening to " .. p.Name, 3)
        end
    elseif cmd == "up" then startMovement(nil, nil, false, false, true) sendNotification("Piyap Hub", "Tweening Upwards", 3)
    elseif cmd == "kill" or cmd == "k" then local p = getPlayer(args[2]) if p then startMovement(nil, p, false, true, false) sendNotification("Piyap Hub", "Orbiting " .. p.Name, 3) end
    elseif cmd == "killspeed" or cmd == "ksp" then
        local spd = tonumber(args[2]) if spd then _G.PiyapSettings.KillSpeed = spd saveSettings() sendNotification("Piyap Hub", "Kill Speed: " .. spd, 3) end
    elseif cmd == "tweenspeed" then
        local spd = tonumber(args[2]) if spd then _G.PiyapSettings.TweenSpeed = spd saveSettings() sendNotification("Piyap Hub", "Tween Speed: " .. spd, 3) end
    elseif cmd == "looptween" or cmd == "ltween" then local p = getPlayer(args[2]) if p then startMovement(nil, p, false, false, false) sendNotification("Piyap Hub", "Loop Tweening " .. p.Name, 3) end
    elseif cmd == "hunt" or cmd == "h" then local p = getPlayer(args[2]) if p then startMovement(nil, p, true, false, false) sendNotification("Piyap Hub", "Hunting " .. p.Name, 3) end
    elseif cmd == "fa" or cmd == "fastattack" then
        _G.PiyapSettings.FastAttack = forcedState ~= nil and forcedState or not _G.PiyapSettings.FastAttack 
        saveSettings() 
        sendNotification("Piyap Hub", "Fast Attack: " .. (_G.PiyapSettings.FastAttack and "ON" or "OFF"), 3)
    elseif cmd == "faspeed" then
        local spd = tonumber(args[2]) if spd then _G.PiyapSettings.FaSpeed = spd saveSettings() sendNotification("Piyap Hub", "FA Speed: " .. spd, 3) end
    elseif cmd == "q" or cmd == "autoq" then
        _G.PiyapSettings.AutoQ = forcedState ~= nil and forcedState or not _G.PiyapSettings.AutoQ 
        saveSettings() 
        sendNotification("Piyap Hub", "Auto Q: " .. (_G.PiyapSettings.AutoQ and "ON" or "OFF"), 3)
        if not _G.PiyapSettings.AutoQ then pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game) end) end
    elseif cmd == "autow" then
        _G.PiyapSettings.AutoW = forcedState ~= nil and forcedState or not _G.PiyapSettings.AutoW 
        saveSettings() 
        sendNotification("Piyap Hub", "Auto W: " .. (_G.PiyapSettings.AutoW and "ON" or "OFF"), 3)
        if not _G.PiyapSettings.AutoW then pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game) end) end
    elseif cmd == "spinbot" then
        _G.PiyapSettings.Spinbot = forcedState ~= nil and forcedState or not _G.PiyapSettings.Spinbot 
        saveSettings() 
        handleSpinbot() 
        sendNotification("Piyap Hub", "Spinbot: " .. (_G.PiyapSettings.Spinbot and "ON" or "OFF"), 3)
    elseif cmd == "nc" or cmd == "noclip" then
        standaloneNoclip = forcedState ~= nil and forcedState or not standaloneNoclip 
        handleStandaloneNoclip() 
        sendNotification("Piyap Hub", "Noclip: " .. (standaloneNoclip and "ON" or "OFF"), 3)
    elseif cmd == "fc" or cmd == "freecam" then
        toggleFreecam() 
        sendNotification("Piyap Hub", "Freecam: " .. (isFreecam and "ON" or "OFF"), 3)
    elseif cmd == "fov" then
        local val = tonumber(args[2]) if val then Workspace.CurrentCamera.FieldOfView = val sendNotification("Piyap Hub", "FOV: " .. val, 3) end
    elseif cmd == "attackfriends" then
        _G.PiyapSettings.AttackFriends = not _G.PiyapSettings.AttackFriends saveSettings() sendNotification("Piyap Hub", "Attack Friends: " .. (_G.PiyapSettings.AttackFriends and "ON" or "OFF"), 3)
    elseif cmd == "fly" then 
        toggleFly() 
        sendNotification("Piyap Hub", "Fly: " .. (isFlying and "ON" or "OFF"), 3)
    elseif cmd == "flyspeed" then
        local spd = tonumber(args[2]) if spd then _G.PiyapSettings.FlySpeed = spd saveSettings() sendNotification("Piyap Hub", "Fly Speed: " .. spd, 3) end
    elseif cmd == "aimbot" then
        sendNotification("Piyap Hub", "Loading aimbot...", 3)
        task.spawn(function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/cokeboysclient/cokeboys-bloxfruits/refs/heads/main/main.lua"))() end) end)
    elseif cmd == "nofog" then
        _G.PiyapSettings.NoFog = not _G.PiyapSettings.NoFog saveSettings() sendNotification("Piyap Hub", "No Fog: " .. (_G.PiyapSettings.NoFog and "ON" or "OFF"), 3)
    elseif cmd == "fb" or cmd == "fullbright" then
        _G.PiyapSettings.Fullbright = not _G.PiyapSettings.Fullbright saveSettings() sendNotification("Piyap Hub", "Fullbright: " .. (_G.PiyapSettings.Fullbright and "ON" or "OFF"), 3)
    elseif cmd == "esp" then
        _G.PiyapSettings.ESP.Enabled = not _G.PiyapSettings.ESP.Enabled saveSettings() sendNotification("Piyap Hub", "ESP: " .. (_G.PiyapSettings.ESP.Enabled and "ON" or "OFF"), 3)
    elseif cmd == "espset" or cmd == "espsettings" then EspGui.Enabled = not EspGui.Enabled sendNotification("Piyap Hub", "ESP Settings Opened", 3)
    elseif cmd == "rj" or cmd == "rejoin" then
        safeRejoin()
    elseif cmd == "re" then local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") if hum then hum.Health = 0 sendNotification("Piyap Hub", "Reset Character", 3) end
    elseif cmd == "stop" or cmd == "s" then
        stopMovement()
        AimlockTarget = nil
        refreshPlayerList()
        sendNotification("Piyap Hub", "Stopped All Operations", 3)
    elseif cmd == "keybind" or cmd == "binds" then KeybindGui.Enabled = not KeybindGui.Enabled sendNotification("Piyap Hub", "Keybinds GUI Opened", 3)
    elseif cmd == "wp" then WpGui.Enabled = not WpGui.Enabled sendNotification("Piyap Hub", "Waypoints GUI Opened", 3)
    elseif cmd == "cmds" then CmdsGui.Enabled = not CmdsGui.Enabled sendNotification("Piyap Hub", "Commands GUI Opened", 3)
    else
        sendNotification("Error", "Command not found: " .. cmd, 3)
    end
end

