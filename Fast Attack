local NotifGui = Instance.new("ScreenGui")
NotifGui.Name = "PiyapNotifications"
NotifGui.ResetOnSpawn = false
NotifGui.Parent = targetParent

local function sendNotification(title, text, duration)
    duration = duration or 3
    
    local count = #NotifGui:GetChildren()
    local yOffset = -80 - (count * 70)
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 250, 0, 60)
    frame.Position = UDim2.new(1, 10, 1, yOffset)
    frame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    frame.BorderSizePixel = 0
    frame.Parent = NotifGui
    
    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 4)
    
    local titleLbl = Instance.new("TextLabel", frame)
    titleLbl.Size = UDim2.new(1, -20, 0, 20)
    titleLbl.Position = UDim2.new(0, 10, 0, 5)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLbl.TextSize = 13
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Text = title
    
    local textLbl = Instance.new("TextLabel", frame)
    textLbl.Size = UDim2.new(1, -20, 0, 30)
    textLbl.Position = UDim2.new(0, 10, 0, 25)
    textLbl.BackgroundTransparency = 1
    textLbl.Font = Enum.Font.GothamMedium
    textLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    textLbl.TextSize = 11
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.TextWrapped = true
    textLbl.Text = text

    local ti = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    TweenService:Create(frame, ti, {Position = UDim2.new(1, -260, 1, yOffset)}):Play()

    task.delay(duration, function()
        if frame then
            local tiOut = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            local tweenOut = TweenService:Create(frame, tiOut, {Position = UDim2.new(1, 10, 1, frame.Position.Y.Offset)})
            tweenOut:Play()
            tweenOut.Completed:Connect(function() frame:Destroy() end)
        end
    end)
end

