addConn(UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.Semicolon then openCmdBar() end
    if not gpe and input.UserInputType == Enum.UserInputType.Keyboard and not currentlyBinding then
        local pressedKey = input.KeyCode.Name
        for cmdStr, boundKey in pairs(_G.PiyapSettings.Keybinds) do
            if boundKey ~= "" and pressedKey == boundKey then 
                if cmdStr == "fly" then
                    executeCommand(cmdStr, not isFlying)
                elseif cmdStr == "fa" then
                    executeCommand(cmdStr, not _G.PiyapSettings.FastAttack)
                elseif cmdStr == "q" then
                    executeCommand(cmdStr, not _G.PiyapSettings.AutoQ)
                elseif cmdStr == "autow" then
                    executeCommand(cmdStr, not _G.PiyapSettings.AutoW)
                elseif cmdStr == "cf" then
                    executeCommand(cmdStr, not _G.PiyapSettings.ChestFarm)
                elseif cmdStr == "spinbot" then
                    executeCommand(cmdStr, not _G.PiyapSettings.Spinbot)
                elseif cmdStr == "nc" then
                    executeCommand(cmdStr, not standaloneNoclip)
                elseif cmdStr == "fc" then
                    executeCommand(cmdStr, not isFreecam)
                elseif cmdStr == "esp" then
                    executeCommand(cmdStr, not _G.PiyapSettings.ESP.Enabled)
                elseif cmdStr == "nofog" then
                    executeCommand(cmdStr, not _G.PiyapSettings.NoFog)
                elseif cmdStr == "fb" then
                    executeCommand(cmdStr, not _G.PiyapSettings.Fullbright)
                else
                    executeCommand(cmdStr)
                end
            end
        end
    end
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = true elseif input.KeyCode == Enum.KeyCode.S then FlyKeys.S = true
    elseif input.KeyCode == Enum.KeyCode.A then FlyKeys.A = true elseif input.KeyCode == Enum.KeyCode.D then FlyKeys.D = true
    elseif input.KeyCode == Enum.KeyCode.Space then FlyKeys.Space = true elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then FlyKeys.Control = true end
end))

addConn(UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then FlyKeys.W = false elseif input.KeyCode == Enum.KeyCode.S then FlyKeys.S = false
    elseif input.KeyCode == Enum.KeyCode.A then FlyKeys.A = false elseif input.KeyCode == Enum.KeyCode.D then FlyKeys.D = false
    elseif input.KeyCode == Enum.KeyCode.Space then FlyKeys.Space = false elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then FlyKeys.Control = false end
end))

