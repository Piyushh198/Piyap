local FlyKeys = {W=false, A=false, S=false, D=false, Space=false, Control=false}
local flyConn, fcConn, standaloneNcConn = nil, nil, nil
local isFlying, isFreecam, standaloneNoclip = false, false, false
local fcYaw, fcPitch = 0, 0

local function handleStandaloneNoclip()
