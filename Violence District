-- EVENT-DRIVEN REGISTRATION (ON-DEMAND LOADING - ZERO LAG SPIKES)
function EspEngine.registerObject(desc)
    if not desc or not desc.Parent then return end

    -- Strictly never register any player character or killer as a static object (prevents purple ScpESP on killer)
    if desc:IsA("Model") then
        if Players:GetPlayerFromCharacter(desc) or isCharacterKiller(desc) or desc:GetAttribute("Killer") or desc:GetAttribute("MorphedKiller") or CollectionService:HasTag(desc, "Killer") then
            return
        end
    end
    local nl = desc.Name:lower()

    -- 1. Sacrificial Hooks (Strictly require child HookPoint)
    if desc:IsA("Model") and (desc.Name == "Hook" or nl:find("hook")) and desc:FindFirstChild("HookPoint") and not desc:FindFirstAncestorOfClass("Model") then
        local hp = desc:FindFirstChild("HookPoint")
        if not espCache.Hooks[desc] then
            espCache.Hooks[desc] = hp
            if EspState.hook then
                EspEngine.updateStaticObjectESP(desc, true, "PiyapHookESP", Color3.fromRGB(255, 0, 0), hp)
            end
        end

    -- 2. Real Pallets (Excludes crates)
    elseif desc:IsA("Model") and (desc.Name == "Newpallet" or (nl:find("pallet") and not nl:find("crate") and not nl:find("shake") and not nl:find("break"))) then
        local isRealPallet = (desc.Name == "Newpallet") or (desc:FindFirstChild("Intact") or desc:FindFirstChild("Broken") or desc:FindFirstChild("hitbox") or (desc.Parent and desc.Parent.Name:lower() == "pallets"))
        if isRealPallet and not espCache.Pallets[desc] then
            local targetPart = (desc:FindFirstChild("Intact") and (desc.Intact:FindFirstChild("Pallet") or desc.Intact:FindFirstChildWhichIsA("BasePart", true))) or desc:FindFirstChild("Pallet") or desc:FindFirstChild("hitbox") or desc:FindFirstChildWhichIsA("BasePart", true)
            if targetPart then
                espCache.Pallets[desc] = targetPart
                if EspState.pallet then
                    EspEngine.updateStaticObjectESP(desc, true, "PiyapPalletESP", Color3.fromRGB(150, 50, 255), targetPart)
                end
            end
        end

    -- 3. Real Vaults (Must have VaultTrigger or VaultPoint; Excludes EntranceWindow)
    elseif desc:IsA("Model") and (nl == "window" or nl:find("vault") or (nl:find("window") and not nl:find("entrance") and not nl:find("blind"))) then
        if desc.Name == "Window" or desc:FindFirstChild("VaultTrigger") or desc:FindFirstChild("VaultPoint", true) then
            local hasTrigger = desc:FindFirstChild("VaultTrigger") or desc:FindFirstChild("VaultPoint", true)
            local hasBottom = desc:FindFirstChild("Bottom")
            if (hasTrigger or hasBottom) and not espCache.Vaults[desc] then
                espCache.Vaults[desc] = true
                if EspState.vault then
                    local vTarget = EspEngine.getVaultHighlightTarget(desc)
                    EspEngine.updateStaticObjectESP(desc, true, "PiyapVaultESP", Color3.fromRGB(255, 235, 0), vTarget)
                end
            end
        end

    -- 4. Generators
    elseif desc:IsA("Model") and (nl == "generator" or nl == "gen") and not desc:FindFirstAncestorOfClass("Model") then
        if not espCache.Generators[desc] then
            local hitPart = desc:FindFirstChild("HitBox") or desc:FindFirstChild("GeneratorBody") or desc:FindFirstChild("RootPart") or EspEngine.getBasePart(desc)
            espCache.Generators[desc] = hitPart or true
            if EspState.gen then
                local isCompleted = desc:GetAttribute("Completed") == true or desc:GetAttribute("RepairProgress") == 100
                local col = isCompleted and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 170, 0)
                EspEngine.updateStaticObjectESP(desc, true, "PiyapGenESP", col, hitPart)
            end
        end

    -- 5. Escape Gates & Exit Levers
    elseif nl == "exitlever" or nl == "lever" or (desc:IsA("Model") and (nl == "gate" or nl == "escapegate") and desc:FindFirstChild("ExitLever", true)) then
        local leverModel = desc:IsA("Model") and (desc.Name == "ExitLever" and desc or desc:FindFirstChild("ExitLever", true)) or desc
        local hitPart = (leverModel:IsA("Model") and (leverModel:FindFirstChild("Lever") or leverModel:FindFirstChild("Main") or EspEngine.getBasePart(leverModel))) or (leverModel:IsA("BasePart") and leverModel)
        if hitPart and not espCache.ExitLevers[leverModel] then
            espCache.ExitLevers[leverModel] = hitPart
            if EspState.gate then
                EspEngine.updateStaticObjectESP(leverModel, true, "PiyapGateESP", Color3.fromRGB(0, 255, 255), hitPart)
            end
        end
    elseif nl == "finishline" or nl == "fininshline" then
        espCache.FinishLines[desc] = true

    -- 6. Pumpkins
    elseif (desc:IsA("Model") or desc:IsA("BasePart")) and nl:find("pumpkin") and desc.ClassName ~= "Folder" then
        if not espCache.Pumpkins[desc] then
            local target = desc:FindFirstChild("HB") or (desc:IsA("BasePart") and desc) or (desc:IsA("Model") and desc.PrimaryPart) or EspEngine.getBasePart(desc)
            if target then
                espCache.Pumpkins[desc] = target
                if EspState.pumpkin then
                    EspEngine.updateStaticObjectESP(desc, true, "PiyapPumpkinESP", Color3.fromRGB(255, 128, 0), target)
                end
            end
        end

    -- 7. Traps (BearTrap)
    elseif desc:IsA("Model") and (nl == "beartrap" or (nl:find("trap") and not nl:find("traversal") and not nl:find("strafe"))) then
        if not espCache.Traps[desc] then
            local hitPart = desc:FindFirstChild("hitbox") or desc:FindFirstChild("Handle") or desc:FindFirstChild("Cube") or EspEngine.getBasePart(desc)
            if hitPart then
                espCache.Traps[desc] = hitPart
                if EspState.trap then
                    local isArmed = desc:GetAttribute("Armed") ~= false
                    local trapCol = isArmed and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(150, 150, 150)
                    EspEngine.updateStaticObjectESP(desc, true, "PiyapTrapESP", trapCol, hitPart)
                end
            end
        end

    -- 8. SCP / Zombies (AI Minions only, strictly never players or killers)
    elseif (nl:find("zombie") or nl:find("minion")) and desc:IsA("Model") and not desc:FindFirstAncestorOfClass("Model") and not Players:GetPlayerFromCharacter(desc) and not isCharacterKiller(desc) then
        if not espCache.Scps[desc] then
            espCache.Scps[desc] = true
            if EspState.scp then
                local targetPart = desc:FindFirstChild("HumanoidRootPart") or desc:FindFirstChild("Torso") or EspEngine.getBasePart(desc)
                EspEngine.updateStaticObjectESP(desc, true, "PiyapScpESP", Color3.fromRGB(170, 0, 255), targetPart)
            end
        end
    end
end

function EspEngine.unregisterObject(desc)
    if not desc then return end
    espCache.Hooks[desc] = nil
    espCache.Generators[desc] = nil
    espCache.Pallets[desc] = nil
    espCache.ExitLevers[desc] = nil
    espCache.FinishLines[desc] = nil
    espCache.Scps[desc] = nil
    espCache.Pumpkins[desc] = nil
    espCache.Traps[desc] = nil
    espCache.Vaults[desc] = nil

    if staticHighlights[desc] then
        pcall(function() staticHighlights[desc]:Destroy() end)
        staticHighlights[desc] = nil
    end
    if staticTags[desc] then
        if staticTags[desc].Gui then pcall(function() staticTags[desc].Gui:Destroy() end) end
        staticTags[desc] = nil
    end
    if vaultAdornments[desc] then
        pcall(function() vaultAdornments[desc]:Destroy() end)
        vaultAdornments[desc] = nil
    end
end

function EspEngine.clearAllEspCacheAndObjects()
    espCache.Hooks = {}
    espCache.Generators = {}
    espCache.Pallets = {}
    espCache.ExitLevers = {}
    espCache.FinishLines = {}
    espCache.Scps = {}
    espCache.Pumpkins = {}
    espCache.Vaults = {}
    espCache.Traps = {}

    for obj, hl in pairs(staticHighlights) do
        if hl then pcall(function() hl:Destroy() end) end
    end
    table.clear(staticHighlights)

    for obj, tagData in pairs(staticTags) do
        if tagData and tagData.Gui then pcall(function() tagData.Gui:Destroy() end) end
    end
    table.clear(staticTags)

    for obj, adorn in pairs(vaultAdornments) do
        if adorn then pcall(function() adorn:Destroy() end) end
    end
    table.clear(vaultAdornments)
end

function EspEngine.updateCache()
    if EspState.isUpdatingCache then return end
    EspState.isUpdatingCache = true
    task.spawn(function()
        local mapFolder = Workspace:FindFirstChild("Map")
        
        -- Direct dedicated folders for instant discovery
        if mapFolder then
            local hooksFolder = mapFolder:FindFirstChild("Hooks")
            if hooksFolder then
                for _, h in ipairs(hooksFolder:GetChildren()) do
                    if h:IsA("Model") and h:FindFirstChild("HookPoint") then
                        espCache.Hooks[h] = h:FindFirstChild("HookPoint")
                    end
                end
            end

            local pumpkinFolder = mapFolder:FindFirstChild("Pumpkins")
            if pumpkinFolder then
                for _, p in ipairs(pumpkinFolder:GetChildren()) do
                    if p:IsA("Model") or p:IsA("BasePart") then
                        local target = p:FindFirstChild("HB") or (p:IsA("BasePart") and p) or p.PrimaryPart or (p:IsA("Model") and p:FindFirstChildWhichIsA("BasePart", true))
                        if target then espCache.Pumpkins[p] = target end
                    end
                end
            end

            local palletFolder = mapFolder:FindFirstChild("pallets")
            if palletFolder then
                for _, p in ipairs(palletFolder:GetChildren()) do
                    if p:IsA("Model") and not p.Name:lower():find("crate") then
                        local targetPart = (p:FindFirstChild("Intact") and (p.Intact:FindFirstChild("Pallet") or p.Intact:FindFirstChildWhichIsA("BasePart", true))) or p:FindFirstChild("Pallet") or p:FindFirstChild("hitbox") or p:FindFirstChildWhichIsA("BasePart", true)
                        if targetPart then espCache.Pallets[p] = targetPart end
                    end
                end
            end
        end

        -- CollectionService tagged items
        for _, taggedGen in ipairs(CollectionService:GetTagged("Generator")) do
            local model = taggedGen:IsA("Model") and taggedGen or taggedGen:FindFirstAncestorOfClass("Model") or taggedGen
            local hitPart = model:FindFirstChild("HitBox") or model:FindFirstChild("GeneratorBody") or model:FindFirstChild("RootPart") or EspEngine.getBasePart(model)
            espCache.Generators[model] = hitPart or true
        end

        for _, taggedVault in ipairs(CollectionService:GetTagged("VaultPoint")) do
            local model = taggedVault:FindFirstAncestorOfClass("Model") or taggedVault
            if model and model:IsA("Model") and (model:FindFirstChild("Bottom") or model:FindFirstChild("VaultTrigger")) then
                espCache.Vaults[model] = true
            end
        end

        -- Single scan of map descendants
        if mapFolder then
            for _, desc in ipairs(mapFolder:GetDescendants()) do
                EspEngine.registerObject(desc)
            end
        end

        -- Scan workspace root children (e.g. traps, zombies)
        for _, obj in ipairs(Workspace:GetChildren()) do
            EspEngine.registerObject(obj)
        end

        -- Listen for future additions inside Map
        if EspState.mapDescendantConn then
            EspState.mapDescendantConn:Disconnect()
            EspState.mapDescendantConn = nil
        end
        if mapFolder then
            EspState.mapDescendantConn = mapFolder.DescendantAdded:Connect(EspEngine.registerObject)
        end

        -- Immediately display ESP for all currently active categories
        EspEngine.refreshAllActiveStaticESP()

        EspState.isUpdatingCache = false
    end)
end

