                    if carryRemotes then
                        pcall(function()
                            if carryRemotes:FindFirstChild("HookEvent") then carryRemotes.HookEvent:FireServer(hookPart) end
                            if carryRemotes:FindFirstChild("HookCommit") then carryRemotes.HookCommit:FireServer(hookPart) end
                        end)
                    end
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                        task.delay(0.08, function()
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                        end)
                    end)
                end
            end
        end

        -- 3. AUTO BREAK PALLETS (Throttled with cooldown)
        if autoBreakPallets and (tick() - HeartbeatState.lastAutoBreakTime > 0.4) then
            local palletRemotes = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Pallet")
            local jasonRemotes = palletRemotes and palletRemotes:FindFirstChild("Jason")

            for pallet, targetPart in pairs(espCache.Pallets) do
                if pallet and pallet.Parent then
                    local prim = targetPart or EspEngine.getBasePart(pallet)
                    if prim and (prim.Position - root.Position).Magnitude < 14 then
                        HeartbeatState.lastAutoBreakTime = tick()
                        if jasonRemotes then
                            pcall(function() jasonRemotes["Destroy-Global"]:FireServer(pallet) end)
                            pcall(function() jasonRemotes.PalletBreakCommit:FireServer(pallet) end)
                        end
                        triggerKey()
                        break
                    end
                end
            end
        end


    end

    -- SURVIVOR AUTO PARRY (LIVE KILLER TRACKING, WEAPON LUNGE/ATTACK DETECTION, MULTI-TARGET DISAMBIGUATION)
    if not isKiller and autoParryEnabled and root and (parryWhileWalking or not isLocalPlayerWalking()) and (EspEngine.isParryingDaggerEquipped(char) or ensureParryingDaggerEquipped(char)) then
        local myPos = root.Position
        local attackingKiller = nil

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local isK = (plr.Team and plr.Team.Name == "Killer") or 
                            CollectionService:HasTag(plr.Character, "Killer") or 
                            plr.Character:GetAttribute("Killer") or 
                            plr.Character:GetAttribute("MorphedKiller")
                if isK then
                    local kRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                    if kRoot and (myPos - kRoot.Position).Magnitude <= math.max(MAX_PARRY_DISTANCE + 5, 16) then
                        if EspEngine.isKillerAttackingMe(plr.Character) then
                            attackingKiller = plr.Character
                            break
                        end
                    end
                end
            end
        end

        if not attackingKiller then
            for _, kChar in ipairs(CollectionService:GetTagged("Killer")) do
                if kChar:IsA("Model") and kChar ~= char then
                    local kRoot = kChar:FindFirstChild("HumanoidRootPart")
                    if kRoot and (myPos - kRoot.Position).Magnitude <= math.max(MAX_PARRY_DISTANCE + 5, 16) then
                        if EspEngine.isKillerAttackingMe(kChar) then
                            attackingKiller = kChar
                            break
                        end
                    end
                end
            end
        end

        if attackingKiller then
            EspEngine.triggerParry()
        end
    end
end)

-- ESP Rendering Background Worker (Lightweight, Butter-Smooth & Reactive Hook States)
task.spawn(function()
    while task.wait(0.25) do
        -- 1. Prune dead player highlights & tags
        for char, hl in pairs(playerHighlights) do
            if not char or not char.Parent or not char:IsDescendantOf(Workspace) then 
                if hl then pcall(function() hl:Destroy() end) end
                playerHighlights[char] = nil 
            end
        end

        for char, tagData in pairs(playerTags) do
            if not char or not char.Parent or not char:IsDescendantOf(Workspace) then
                if tagData and tagData.Gui then pcall(function() tagData.Gui:Destroy() end) end
                playerTags[char] = nil
            end
        end

        -- 2. Update players (Killer & Survivors with Hook State Tracking)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local char = p.Character
                local isKiller = isCharacterKiller(char) or (p.Team and p.Team.Name:lower() == "killer") or CollectionService:HasTag(char, "Killer") or (char:GetAttribute("MorphedKiller") ~= nil) or (char:GetAttribute("Killer") == true) or (p:GetAttribute("Killer") == true) or (p:GetAttribute("Role") == "Killer")
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                
                -- PURGE any static highlights (e.g. ScpESP) if accidentally placed on a player/killer character
                if staticHighlights[char] then
                    pcall(function() staticHighlights[char]:Destroy() end)
                    staticHighlights[char] = nil
                    espCache.Scps[char] = nil
                    espCache.Pallets[char] = nil
                end
                for _, h in ipairs(char:GetChildren()) do
                    if h:IsA("Highlight") and h.Name ~= "PiyapKillerESP" and h.Name ~= "PiyapSurvivorESP" then
                        pcall(function() h:Destroy() end)
                    end
                end

                if (isKiller and EspState.killer) or (not isKiller and EspState.survivor) then
                    local isHooked = not isKiller and (
                        char:GetAttribute("IsHooked") == true or
                        char:GetAttribute("Hooked") == true or
                        (char:GetAttribute("HookPhase") and char:GetAttribute("HookPhase") > 0) or
                        CollectionService:HasTag(char, "Hooked")
                    )

                    -- Killer: Pure Bright Red (Never purple) | Hooked Survivor: Crimson Red | Normal Survivor: Pure Green
                    local targetColor
                    if isKiller then
                        targetColor = Color3.fromRGB(255, 0, 0) -- Pure Bright Red
                    elseif isHooked then
                        targetColor = Color3.fromRGB(255, 30, 30) -- Red when hooked
                    else
                        targetColor = Color3.fromRGB(50, 255, 50) -- Normal green when unhooked
                    end

                    if EspState.highlight then
                        if not playerHighlights[char] or not playerHighlights[char].Parent then
                            local hl = Instance.new("Highlight")
                            hl.Name = isKiller and "PiyapKillerESP" or "PiyapSurvivorESP"
                            hl.Adornee = char
                            hl.OutlineColor = targetColor
                            hl.FillColor = targetColor
                            hl.FillTransparency = isKiller and 0.35 or 0.5
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = char
                            playerHighlights[char] = hl
                        end
                        if playerHighlights[char] then
                            playerHighlights[char].Enabled = true
                            playerHighlights[char].FillColor = targetColor
                            playerHighlights[char].OutlineColor = targetColor
                            playerHighlights[char].FillTransparency = isKiller and 0.35 or 0.5
                            playerHighlights[char].OutlineTransparency = 0
                        end
                    else
                        if playerHighlights[char] then playerHighlights[char].Enabled = false end
                    end

                    if (EspState.name or EspState.distance) and rootPart then
                        if not playerTags[char] or not playerTags[char].Gui or not playerTags[char].Gui.Parent then
                            local tagGui = Instance.new("BillboardGui")
                            tagGui.Name = "PiyapPlayerTag"
                            tagGui.Adornee = rootPart
                            tagGui.Size = UDim2.new(0, 200, 0, 50)
                            tagGui.StudsOffset = Vector3.new(0, 0, 0)
                            tagGui.AlwaysOnTop = true
                            tagGui.Parent = espContainer

                            local textLabel = Instance.new("TextLabel")
                            textLabel.Name = "TagText"
                            textLabel.Size = UDim2.new(1, 0, 1, 0)
                            textLabel.BackgroundTransparency = 1
                            textLabel.TextColor3 = targetColor
                            textLabel.TextStrokeTransparency = 0.5
                            textLabel.Font = Enum.Font.GothamBold
                            textLabel.TextSize = 12
                            textLabel.Parent = tagGui

                            playerTags[char] = {Gui = tagGui, Label = textLabel}
                        end

                        local tagData = playerTags[char]
                        if tagData and tagData.Gui and tagData.Label then
                            tagData.Gui.Adornee = rootPart
                            tagData.Label.TextColor3 = targetColor
                            local textParts = {}
                            if EspState.name then
                                local nameText = p.DisplayName
                                if isHooked then
                                    nameText = nameText .. " [HOOKED]"
                                end
                                table.insert(textParts, nameText)
                            end
                            if EspState.distance and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                                local dist = math.floor((player.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude)
                                table.insert(textParts, "[" .. dist .. "s]")
                            end
                            tagData.Label.Text = table.concat(textParts, " ")
                            tagData.Gui.Enabled = (#textParts > 0)
                        end
                    else
                        if playerTags[char] and playerTags[char].Gui then
                            playerTags[char].Gui.Enabled = false
                        end
                    end
                else
                    if playerHighlights[char] then playerHighlights[char].Enabled = false end
                    if playerTags[char] and playerTags[char].Gui then playerTags[char].Gui.Enabled = false end
                end
            end
        end

        -- Also scan Workspace for unparented/separate Killer rigs
        if EspState.killer then
            for _, model in ipairs(Workspace:GetChildren()) do
                if model:IsA("Model") and isCharacterKiller(model) and not Players:GetPlayerFromCharacter(model) then
                    local kChar = model
                    local rootPart = kChar:FindFirstChild("HumanoidRootPart")
                    if rootPart then
                        local targetColor = Color3.fromRGB(255, 0, 0)
                        if staticHighlights[kChar] then
                            pcall(function() staticHighlights[kChar]:Destroy() end)
                            staticHighlights[kChar] = nil
                            espCache.Scps[kChar] = nil
                        end
                        for _, h in ipairs(kChar:GetChildren()) do
                            if h:IsA("Highlight") and h.Name ~= "PiyapKillerESP" then
                                pcall(function() h:Destroy() end)
                            end
                        end
                        if EspState.highlight then
                            if not playerHighlights[kChar] or not playerHighlights[kChar].Parent then
                                local hl = Instance.new("Highlight")
                                hl.Name = "PiyapKillerESP"
                                hl.Adornee = kChar
                                hl.OutlineColor = targetColor
                                hl.FillColor = targetColor
                                hl.FillTransparency = 0.35
                                hl.OutlineTransparency = 0
                                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                hl.Parent = kChar
                                playerHighlights[kChar] = hl
                            end
                            if playerHighlights[kChar] then
                                playerHighlights[kChar].Enabled = true
                                playerHighlights[kChar].FillColor = targetColor
                                playerHighlights[kChar].OutlineColor = targetColor
                                playerHighlights[kChar].FillTransparency = 0.35
                                playerHighlights[kChar].OutlineTransparency = 0
                            end
                        else
                            if playerHighlights[kChar] then playerHighlights[kChar].Enabled = false end
                        end
                    end
                end
            end
        end

        -- 3. Dynamic Distance & Generator Percentage update (Only runs when distance or percentage is enabled)
        if EspState.distance or EspState.genPercentage then
            local myPos = player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character.HumanoidRootPart.Position
            for obj, tagData in pairs(staticTags) do
                if tagData and tagData.Gui and tagData.Label and tagData.Gui.Enabled and obj and obj.Parent then
                    local targetPart = tagData.Gui.Adornee or EspEngine.getBasePart(obj)
                    if targetPart then
                        local textParts = {}
                        if EspState.name then
                            local displayName = obj.Name
                            if tagData.Name == "PiyapPalletESP" then displayName = "Pallet"
                            elseif tagData.Name == "PiyapPumpkinESP" then displayName = "Pumpkin"
                            elseif tagData.Name == "PiyapVaultESP" then displayName = "Vault"
                            elseif tagData.Name == "PiyapTrapESP" then displayName = "Trap"
                            elseif tagData.Name == "PiyapScpESP" then displayName = "Zombie"
                            elseif tagData.Name == "PiyapHookESP" then displayName = "Hook"
                            elseif tagData.Name == "PiyapGenESP" then displayName = "Generator"
                            elseif tagData.Name == "PiyapGateESP" then displayName = "Gate"
                            end
                            table.insert(textParts, displayName)
                        end
                        if EspState.distance and myPos then
                            local dist = math.floor((myPos - targetPart.Position).Magnitude)
                            table.insert(textParts, "[" .. dist .. "s]")
                        end
                        if tagData.Name == "PiyapGenESP" and EspState.genPercentage then
                            local progress = obj:GetAttribute("RepairProgress") or 0
                            local pColor = Color3.fromRGB(255, 0, 0)
                            if progress >= 70 then
                                pColor = Color3.fromRGB(0, 255, 0)
                            elseif progress >= 50 then
                                pColor = Color3.fromRGB(255, 255, 0)
                            end
                            table.insert(textParts, tostring(math.floor(progress)))
                            tagData.Label.TextColor3 = pColor
                        end
                        tagData.Label.Text = table.concat(textParts, " ")
                    end
                end
            end
        end

        -- 4. Generator Completed Color Update
        if EspState.gen then
            for obj, _ in pairs(espCache.Generators) do
                if obj and obj.Parent and staticHighlights[obj] then
                    local isCompleted = obj:GetAttribute("Completed") == true or obj:GetAttribute("RepairProgress") == 100
                    local targetCol = isCompleted and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 170, 0)
                    if staticHighlights[obj].FillColor ~= targetCol then
                        staticHighlights[obj].FillColor = targetCol
                        staticHighlights[obj].OutlineColor = targetCol
                    end
                end
            end
        end
    end
end)




