    valueLabel.Size = UDim2.new(1, 0, 1, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.BorderSizePixel = 0
    valueLabel.Text = tostring(default)
    valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    valueLabel.TextSize = 11
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.ZIndex = row.ZIndex + 1
    valueLabel.Parent = badge

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, -28, 0, 6)
    sliderBg.Position = UDim2.new(0, 14, 0, 39)
    sliderBg.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    sliderBg.BorderSizePixel = 0
    sliderBg.ZIndex = row.ZIndex
    sliderBg.Parent = row
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

    local initialPos = math.clamp((default - min) / (max - min), 0, 1)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initialPos, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(250, 250, 250)
    fill.BorderSizePixel = 0
    fill.ZIndex = row.ZIndex + 1
    fill.Parent = sliderBg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 14, 0, 14)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.Position = UDim2.new(initialPos, 0, 0.5, 0)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.ZIndex = row.ZIndex + 2
    thumb.Parent = sliderBg
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local draggingSlider = false
    local currentValue = default
    local function update(input)
        local pos = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        if step and step > 0 then
            currentValue = math.floor(((min + (max - min) * pos) / step) + 0.5) * step
            currentValue = tonumber(string.format("%.1f", currentValue))
        else
            currentValue = math.floor(min + (max - min) * pos + 0.5)
        end
        fill.Size = UDim2.new(pos, 0, 1, 0)
        thumb.Position = UDim2.new(pos, 0, 0.5, 0)
        valueLabel.Text = tostring(currentValue)
        callback(currentValue)
    end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
    
    UIComponents.Sliders[text] = {
        GetState = function() return currentValue end,
        SetState = function(val)
            currentValue = val
            local pos = math.clamp((val - min) / (max - min), 0, 1)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            thumb.Position = UDim2.new(pos, 0, 0.5, 0)
            valueLabel.Text = tostring(val)
            callback(val)
        end
    }
    
    return row
end

