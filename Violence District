local alreadyHandled = false
local lastGoalRot = -9999

RunService.RenderStepped:Connect(function()
    local gui = playerGui:FindFirstChild("SkillCheckPromptGui")
    local check = gui and gui:FindFirstChild("Check")
    if not check or not check.Visible then
        alreadyHandled = false
        lastGoalRot = -9999
        currentLegitTarget = nil
        return
    end

    local line = check:FindFirstChild("Line")
    if not line then return end

    local trapGoal = check:FindFirstChild("TrapGoal")
    local trapPerfect = check:FindFirstChild("TrapPerfect")
    local standardGoal = check:FindFirstChild("Goal")

    local isTrap = (trapGoal and trapGoal.Visible) or (trapPerfect and trapPerfect.Visible) or (player.Character and player.Character:GetAttribute("Trapped") == true)

    if isTrap and not autoSkillTrapEnabled then return end
    if not isTrap and not autoSkillEnabled then return end

    local activeGoal = nil
    if isTrap then
        if autoSkillMode == "Perfect" and trapPerfect and trapPerfect.Visible then
            activeGoal = trapPerfect
        elseif trapGoal and trapGoal.Visible then
            activeGoal = trapGoal
        elseif trapPerfect and trapPerfect.Visible then
            activeGoal = trapPerfect
        else
            activeGoal = standardGoal
        end
    else
        activeGoal = standardGoal
    end

    if not activeGoal then return end

    local goalRot = activeGoal.Rotation
    local lineRot = line.Rotation

    if goalRot ~= lastGoalRot then
        lastGoalRot = goalRot
        alreadyHandled = false
        currentLegitTarget = nil
    end

    if not alreadyHandled then
        local targetMin, targetMax

        if autoSkillMode == "Perfect" then
            -- Great / Perfect zone is [102 + goalRot, 116 + goalRot]
            targetMin = 104.5 + goalRot
            targetMax = 114 + goalRot
        elseif autoSkillMode == "Good" then
            -- Good / Safe zone is [117 + goalRot, 159 + goalRot]
            targetMin = 126 + goalRot
            targetMax = 145 + goalRot
        elseif autoSkillMode == "Legit" then
            -- 80% Great, 20% Good
            if not currentLegitTarget then
                if math.random(1, 100) <= 80 then
                    currentLegitTarget = 104 + math.random(0, 7) + goalRot
                else
                    currentLegitTarget = 124 + math.random(0, 16) + goalRot
                end
            end
            targetMin = currentLegitTarget
            targetMax = currentLegitTarget + 10
        end

        if targetMin and lineRot >= targetMin and lineRot <= (156 + goalRot) then
            alreadyHandled = true
            triggerKey()
        end
    end
end)

