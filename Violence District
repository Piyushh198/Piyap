-- ==========================================
local function doTeleportToFinishLine()
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    local targetPart = nil
    local shortestDist = math.huge
    
    for part, _ in pairs(espCache.FinishLines) do
        local p = getBasePart(part)
        if p and p.Parent then
            local dist = (p.Position - myRoot.Position).Magnitude
            if dist < shortestDist then shortestDist = dist; targetPart = p end
        end
    end
    
    if not targetPart then
        local map = Workspace:FindFirstChild("Map") or Workspace
        for _, obj in ipairs(map:GetDescendants()) do
            local nl = obj.Name:lower()
            if nl == "fininshline" or nl == "finishline" then
                local p = getBasePart(obj)
                if p then targetPart = p break end
            end
        end
    end
    
    if targetPart then
        tweenTeleport(targetPart.CFrame + Vector3.new(0, 3, 0))
    end
end

