            EspEngine.updateStaticObjectESP(obj, true, "PiyapPumpkinESP", Color3.fromRGB(255, 128, 0), targetPart)
        end
    end
    if EspState.vault then
        for obj, _ in pairs(espCache.Vaults) do
            local vTarget = EspEngine.getVaultHighlightTarget(obj)
            EspEngine.updateStaticObjectESP(obj, true, "PiyapVaultESP", Color3.fromRGB(255, 235, 0), vTarget)
        end
    end
    if EspState.trap then
