local function SaveMaster()
    pcall(function()
        if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
        local serializableKeybinds = {}
        for cmd, keyCode in pairs(UIComponents.Keybinds) do
            if typeof(keyCode) == "EnumItem" then
                serializableKeybinds[cmd] = keyCode.Name
            end
        end
        local data = { AutoSave = autoSaveEnabled, AutoLoad = autoLoadEnabled, LastConfig = currentConfigName, Keybinds = serializableKeybinds }
        writefile(ConfigFolder .. "/Master.json", HttpService:JSONEncode(data))
    end)
end

local function SaveConfig(name)
    if name == "" then name = "Default" end
    pcall(function()
        if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
        local serializableKeybinds = {}
        for cmd, keyCode in pairs(UIComponents.Keybinds) do
            if typeof(keyCode) == "EnumItem" then
                serializableKeybinds[cmd] = keyCode.Name
            end
        end
        local data = { Toggles = {}, Sliders = {}, Keybinds = serializableKeybinds }
        for k, v in pairs(UIComponents.Toggles) do
            if k ~= "Auto Save Config" and k ~= "Auto Load Config" and k ~= "Toggle all esp" then
                data.Toggles[k] = v.GetState()
            end
        end
        for k, v in pairs(UIComponents.Sliders) do
            data.Sliders[k] = v.GetState()
        end
        writefile(ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
        showNotification("Saved config: " .. name)
    end)
end

local function LoadConfig(name)
    if name == "" then name = "Default" end
    local path = ConfigFolder .. "/" .. name .. ".json"
    pcall(function()
        if isfile(path) then
            local decoded = HttpService:JSONDecode(readfile(path))
            if decoded.Toggles then
                for k, v in pairs(decoded.Toggles) do
                    if UIComponents.Toggles[k] then UIComponents.Toggles[k].SetState(v) end
                end
            end
            if decoded.Sliders then
                for k, v in pairs(decoded.Sliders) do
                    if UIComponents.Sliders[k] then UIComponents.Sliders[k].SetState(v) end
                end
            end
            if decoded.Keybinds then
                UIComponents.Keybinds = {}
                for k, v in pairs(decoded.Keybinds) do
                    pcall(function()
                        if Enum.KeyCode[v] then
                            UIComponents.Keybinds[k] = Enum.KeyCode[v]
                        end
                    end)
                end
            end
            showNotification("Loaded config: " .. name)
        else
            showNotification("Config not found: " .. name)
        end
    end)
end

local function LoadMaster()
    pcall(function()
        if isfile(ConfigFolder .. "/Master.json") then
            local dec = HttpService:JSONDecode(readfile(ConfigFolder .. "/Master.json"))
            autoSaveEnabled = dec.AutoSave or false
            autoLoadEnabled = dec.AutoLoad or false
            currentConfigName = dec.LastConfig or "Default"
            if dec.Keybinds then
                UIComponents.Keybinds = {}
                for k, v in pairs(dec.Keybinds) do
                    pcall(function()
                        if Enum.KeyCode[v] then
                            UIComponents.Keybinds[k] = Enum.KeyCode[v]
                        end
                    end)
                end
            end
        end
    end)
end

