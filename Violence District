function EspEngine.isParryingDaggerEquipped(char)
    if not char then return false end
    -- Gun presence immediately disqualifies parrying dagger
    if char:FindFirstChild("Twist of Fate") or currentSurvivorItem == "Twist of Fate" then
        return false
    end
    -- Check live ParryClient instance
    local livePc = getgenv()._PiyapActiveParryClient
    if livePc and type(livePc._isEquipped) == "function" and livePc:_isEquipped() then
        return true
    end
    -- Check cached item name
    if currentSurvivorItem and PARRY_DAGGER_NAMES[currentSurvivorItem:lower()] then
        return true
    end
    -- Check tags
    if CollectionService:HasTag(char, "ScytheParrySkin") then
        return true
    end
    -- Check children and backpack
    for _, c in ipairs(char:GetChildren()) do
        local nl = c.Name:lower()
        if PARRY_DAGGER_NAMES[nl] or nl:find("dagger") or nl:find("parry") or nl:find("scythe") then
            if not nl:find("twist") and not nl:find("fate") then
                return true
            end
        end
        if CollectionService:HasTag(c, "ScytheParrySkin") then
            return true
        end
    end
    return false
end

