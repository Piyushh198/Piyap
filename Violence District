-- AUTOMATIC MAP & MATCH RELOAD WATCHDOG (Fires ONLY when map changes or transitions - ZERO periodic re-scans)
task.spawn(function()
    while true do
        task.wait(2.0)
        local currentMap = Workspace:FindFirstChild("Map")
        if currentMap and currentMap ~= EspState.lastKnownMap then
            EspState.lastKnownMap = currentMap
            EspEngine.clearAllEspCacheAndObjects()
            task.wait(0.5)
            EspEngine.updateCache()
        elseif not currentMap and EspState.lastKnownMap ~= nil then
            EspState.lastKnownMap = nil
            EspEngine.clearAllEspCacheAndObjects()
        end
    end
end)

Workspace.ChildAdded:Connect(function(child)
    if child.Name == "Map" and child ~= EspState.lastKnownMap then
        EspState.lastKnownMap = child
        EspEngine.clearAllEspCacheAndObjects()
        task.wait(0.5)
        EspEngine.updateCache()
    else
        EspEngine.registerObject(child)
    end
end)

