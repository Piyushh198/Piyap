createButton(miscPage, "Server Hop", function()
    showNotification("Searching for a new server...")
    task.spawn(function()
        local HttpService = game:GetService("HttpService")
        local TeleportService = game:GetService("TeleportService")
        local placeId = game.PlaceId
        local currentJobId = game.JobId
        
        local function fetchServers(sortOrder)
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=100"
            local res
            local ok = pcall(function()
                if request then
                    res = request({Url = url, Method = "GET"})
                elseif syn and syn.request then
                    res = syn.request({Url = url, Method = "GET"})
                elseif http_request then
                    res = http_request({Url = url, Method = "GET"})
                elseif game.HttpGet then
                    res = {Body = game:HttpGet(url)}
                end
            end)
            if ok and res then
                local body = res.Body or res.body or res
                local sDec, data = pcall(function() return HttpService:JSONDecode(body) end)
                if sDec and data and data.data then return data end
            end
            return nil
        end

        local data = fetchServers("Asc")
        local candidates = {}
        if data and data.data then
            for _, s in ipairs(data.data) do
                if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= currentJobId then
                    table.insert(candidates, s)
                end
            end
        end

        if #candidates == 0 then
            data = fetchServers("Desc")
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= currentJobId then
                        table.insert(candidates, s)
                    end
                end
            end
        end

        if #candidates > 0 then
            local populated = {}
            for _, s in ipairs(candidates) do
                if s.playing >= 1 then table.insert(populated, s) end
            end
            local target = (#populated > 0) and populated[math.random(1, #populated)] or candidates[math.random(1, #candidates)]
            showNotification("Joining server: " .. target.id:sub(1, 8) .. " (" .. target.playing .. "/" .. target.maxPlayers .. ")")
            local tpOk = pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, target.id, player)
            end)
            if not tpOk then
                showNotification("Teleporting to fallback server...")
                TeleportService:Teleport(placeId, player)
            end
        else
            showNotification("No open public servers found. Retrying...")
            TeleportService:Teleport(placeId, player)
        end
    end)
end)

