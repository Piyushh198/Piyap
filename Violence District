function EspEngine.triggerParry()
    local char = player.Character
    if not char then return end
    
    -- Strictly do not parry if local player is walking/moving
    if not parryWhileWalking and isLocalPlayerWalking() then return end

    if not EspEngine.isParryingDaggerEquipped(char) and not ensureParryingDaggerEquipped(char) then return end
    if char:FindFirstChild("Twist of Fate") then return end
    
    local delayTime = autoParryDelay or 0
    -- Debounce check takes delay into account so multiple triggers don't stack
    if tick() - HeartbeatState.lastParryActionTime <= (0.75 + delayTime) then return end
    HeartbeatState.lastParryActionTime = tick()

    local function executeParryAction()
        local curChar = player.Character
        if not curChar then return end
        if not parryWhileWalking and isLocalPlayerWalking() then return end
        if not EspEngine.isParryingDaggerEquipped(curChar) and not ensureParryingDaggerEquipped(curChar) then return end

        -- 1. Native ParryClient:Parry()
        local livePc = getgenv()._PiyapActiveParryClient
        if livePc and type(livePc.Parry) == "function" and livePc:CanUse() then
            livePc:Parry()
            return
        end

        -- 2. Direct server remote dispatch
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local dagger = remotes and remotes:FindFirstChild("Items") and remotes.Items:FindFirstChild("Parrying Dagger")
            local pEvent = dagger and dagger:FindFirstChild("parry")
            if pEvent then pEvent:FireServer(curChar) end
        end)

        -- 3. Instant client input trigger
        pcall(function()
            firesignal(UserInputService.InputBegan, {
                UserInputType = Enum.UserInputType.MouseButton2,
                UserInputState = Enum.UserInputState.Begin
            }, false)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 1)
            task.delay(0.02, function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 1)
                firesignal(UserInputService.InputEnded, {
                    UserInputType = Enum.UserInputType.MouseButton2,
                    UserInputState = Enum.UserInputState.End
                }, false)
            end)
        end)
    end

    if delayTime > 0 then
        task.delay(delayTime, executeParryAction)
    else
        executeParryAction()
    end
end

