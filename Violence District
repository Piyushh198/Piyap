    if EspState.gate then
        for obj, hitPart in pairs(espCache.ExitLevers) do
            EspEngine.updateStaticObjectESP(obj, true, "PiyapGateESP", Color3.fromRGB(0, 255, 255), hitPart)
        end
    end
    if EspState.scp then
        for obj, _ in pairs(espCache.Scps) do
            local targetPart = (obj:IsA("Model") and (obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or EspEngine.getBasePart(obj))) or EspEngine.getBasePart(obj)
            EspEngine.updateStaticObjectESP(obj, true, "PiyapScpESP", Color3.fromRGB(170, 0, 255), targetPart)
        end
    end
    if EspState.pumpkin then
