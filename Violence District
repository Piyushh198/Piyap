-- HELPER: Identify and track both hands and the killer's weapon
function EspEngine.getKillerHands(kChar)
    if not kChar then return nil end

    local rArm = kChar:FindFirstChild("RightHand") or kChar:FindFirstChild("Right Arm")
    local lArm = kChar:FindFirstChild("LeftHand") or kChar:FindFirstChild("Left Arm")
    local kRoot = kChar:FindFirstChild("HumanoidRootPart")

    local weaponPart = nil
    local weapon = kChar:FindFirstChild("Weapon") or kChar:FindFirstChildWhichIsA("Tool")
    if weapon then
        weaponPart = weapon:FindFirstChild("Handle") or weapon:FindFirstChild("Main") or weapon.PrimaryPart or weapon:FindFirstChildWhichIsA("BasePart")
    end
    if not weaponPart then
        for _, desc in ipairs(kChar:GetDescendants()) do
            if desc:IsA("Trail") and desc.Parent and desc.Parent:IsA("BasePart") then
                weaponPart = desc.Parent
                break
            end
        end
    end

    local candidates = {}
    if weaponPart then table.insert(candidates, weaponPart) end
    if rArm then table.insert(candidates, rArm) end
    if lArm then table.insert(candidates, lArm) end

    return {
        right = rArm,
        left = lArm,
        weapon = weaponPart,
        root = kRoot,
        candidates = candidates
    }
end

