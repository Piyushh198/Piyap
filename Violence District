-- MOVEMENT, FALL, VAULT & PALLET WATCHER
local fallAirborne = false
local fallLaunchY = 0
local fallStartTime = 0

local isVaultingActive = false
local isPalletSlideActive = false
local lastVaultBoostTime = 0
local lastPalletBoostTime = 0

local function isNearPallet(pos, maxDist)
    maxDist = maxDist or 8.5
    for pObj, pPart in pairs(espCache.Pallets) do
        if pObj and pObj.Parent then
            local part = (typeof(pPart) == "Instance" and pPart.Parent and pPart) or EspEngine.getBasePart(pObj)
            if part and (part.Position - pos).Magnitude <= maxDist then
                return true, pObj, part
            end
        end
    end
    local map = Workspace:FindFirstChild("Map") or Workspace
    local pFolder = map:FindFirstChild("pallets") or map:FindFirstChild("Pallets")
    if pFolder then
        for _, p in ipairs(pFolder:GetChildren()) do
            local base = EspEngine.getBasePart(p)
            if base and (base.Position - pos).Magnitude <= maxDist then
                return true, p, base
            end
        end
    end
    return false
end

local function isNearVault(pos, maxDist)
    maxDist = maxDist or 8.5
    for vObj, _ in pairs(espCache.Vaults) do
        if vObj and vObj.Parent then
            local part = EspEngine.getVaultHighlightTarget(vObj) or EspEngine.getBasePart(vObj)
            if part and (part.Position - pos).Magnitude <= maxDist then
                return true, vObj, part
            end
        end
    end
    for _, taggedVault in ipairs(CollectionService:GetTagged("VaultPoint")) do
        if taggedVault:IsA("BasePart") and (taggedVault.Position - pos).Magnitude <= maxDist then
            return true, taggedVault.Parent, taggedVault
        end
    end
    return false
end

local function triggerVaultBoost()
    if not boostWhenVaultEnabled then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local isKiller = isCharacterKiller(char) or (player.Team and player.Team.Name:lower() == "killer")
    if isKiller or char:GetAttribute("Knocked") then return end

    -- STRICT CHECK: Must be within 8.5 studs of a real window/vault (never activates from random animations)
    if not isNearVault(root.Position, 8.5) then
        return
    end

    local now = tick()
    if now - lastVaultBoostTime < 0.6 then return end
    lastVaultBoostTime = now
    vaultBoostEndTime = now + vaultBoostDuration
    showNotification("Vault Boost: Active (" .. tostring(vaultBoostDuration) .. "s)")
end

local function triggerPalletBoost()
    if not boostWhenPalletEnabled then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local isKiller = isCharacterKiller(char) or (player.Team and player.Team.Name:lower() == "killer")
    if isKiller or char:GetAttribute("Knocked") then return end

    -- STRICT CHECK: Must be within 8.5 studs of a real pallet (never activates from random animations)
    if not isNearPallet(root.Position, 8.5) then
        return
    end

    local now = tick()
    if now - lastPalletBoostTime < 0.6 then return end
    lastPalletBoostTime = now
    palletBoostEndTime = now + palletBoostDuration
    showNotification("Pallet Boost: Active (" .. tostring(palletBoostDuration) .. "s)")
end

local function setupMovementWatcher(targetChar)
    if not targetChar then return end
    local hum = targetChar:WaitForChild("Humanoid", 3) or targetChar:FindFirstChildOfClass("Humanoid")
    local root = targetChar:WaitForChild("HumanoidRootPart", 3) or targetChar:FindFirstChild("HumanoidRootPart")
    if hum then
        lastRecordedHealth = hum.Health
        hum.HealthChanged:Connect(function(newHealth)
            if boostWhenInjuredEnabled and newHealth < lastRecordedHealth and newHealth > 0 and not targetChar:GetAttribute("Knocked") and not isCharacterKiller(targetChar) and not (player.Team and player.Team.Name:lower() == "killer") then
                boostEndTime = tick() + boostWhenInjuredDuration
                showNotification("Injured Boost: Active (" .. tostring(boostWhenInjuredDuration) .. "s)")
            end
            lastRecordedHealth = newHealth
        end)

        -- StateChanged fall detection fallback
        hum.StateChanged:Connect(function(oldState, newState)
            if newState == Enum.HumanoidStateType.Freefall then
                if not fallAirborne then
                    fallAirborne = true
                    fallStartTime = tick()
                    if root then fallLaunchY = root.Position.Y end
                end
            elseif (newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running) and fallAirborne then
                local fallTime = tick() - fallStartTime
                local currentY = root and root.Position.Y or fallLaunchY
                local netDrop = fallLaunchY - currentY
                fallAirborne = false

                local isTraversing = isVaultingActive or isPalletSlideActive or (tick() - lastVaultBoostTime < 0.9) or (tick() - lastPalletBoostTime < 0.9)
                if not isTraversing and netDrop >= 1.8 and fallTime >= 0.15 and boostWhenFallEnabled and not targetChar:GetAttribute("Knocked") and not isCharacterKiller(targetChar) and not (player.Team and player.Team.Name:lower() == "killer") then
                    fallBoostEndTime = tick() + fallBoostDuration
                    showNotification("Fall Boost: Active (" .. tostring(fallBoostDuration) .. "s)")
                end
            end
        end)

        -- Animation-level traversal completion tracking (Strictly verified by proximity and specific animation names)
        local function hookAnimator(animator)
            if not animator then return end
            animator.AnimationPlayed:Connect(function(track)
                local rPart = targetChar:FindFirstChild("HumanoidRootPart")
                if not rPart then return end
                local rootPos = rPart.Position

                local trackName = (track.Name or ""):lower()
                local animObj = track.Animation
                local animId = animObj and animObj.AnimationId or ""

                -- Only consider pallet traversal if player is actually near a pallet
                local nearP = isNearPallet(rootPos, 8.5)
                local isPalletTraversal = nearP and (
                    trackName:find("pallet") ~= nil or
                    animId:find("139059236240303") ~= nil or
                    animId:find("134818382394842") ~= nil or
                    animId:find("92681879546490") ~= nil or
                    (trackName:find("slide") ~= nil and not trackName:find("walk") and not trackName:find("run") and not trackName:find("idle") and not trackName:find("strafe") and not trackName:find("turn")) or
                    trackName:find("hurdle") ~= nil
                )

                -- Only consider window vault if player is actually near a window/vault (and not pallet)
                local nearV = isNearVault(rootPos, 8.5)
                local isWindowVault = nearV and not isPalletTraversal and (
                    (trackName:find("vault") ~= nil and not trackName:find("pallet")) or
                    (trackName:find("window") ~= nil and not trackName:find("pallet")) or
                    animId:find("128335151030900") ~= nil or
                    animId:find("117984140708307") ~= nil
                ) and not trackName:find("walk") and not trackName:find("run") and not trackName:find("idle") and not trackName:find("attack")

                if isPalletTraversal then
                    isPalletSlideActive = true
                    track.Stopped:Connect(function()
                        if isPalletSlideActive then
                            isPalletSlideActive = false
                            task.defer(triggerPalletBoost)
                        end
                    end)
                elseif isWindowVault then
                    isVaultingActive = true
                    track.Stopped:Connect(function()
                        if isVaultingActive then
                            isVaultingActive = false
                            task.defer(triggerVaultBoost)
                        end
                    end)
                end
            end)
        end
        local anim = hum:FindFirstChildOfClass("Animator")
        if anim then hookAnimator(anim) end
        hum.ChildAdded:Connect(function(child)
            if child:IsA("Animator") then hookAnimator(child) end
        end)
    end
end

-- Global Remotes & Bindables Hook for Vault and Pallet Events
pcall(function()
    local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
    if remotes then
        local w = remotes:FindFirstChild("Window")
        if w then
            local svc = w:FindFirstChild("SurvivorVaultCompleted")
            if svc and svc:IsA("BindableEvent") then
                svc.Event:Connect(function()
                    triggerVaultBoost()
                end)
            end
            local vce = w:FindFirstChild("VaultCompleteEvent")
            if vce and vce:IsA("RemoteEvent") then
                vce.OnClientEvent:Connect(function(c)
                    if not c or c == player.Character then
                        triggerVaultBoost()
                    end
                end)
            end
        end
        local p = remotes:FindFirstChild("Pallet")
        if p then
            local psce = p:FindFirstChild("PalletSlideCompleteEvent")
            if psce and psce:IsA("RemoteEvent") then
                psce.OnClientEvent:Connect(function(c)
                    if not c or c == player.Character then
                        triggerPalletBoost()
                    end
                end)
            end
        end
    end
end)

