-- Find nearest downed survivor
local function findDownedSurvivor()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, nil end

    local closest, shortestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local cChar = p.Character
            local isDown = cChar:GetAttribute("Knocked") == true
            local isCarried = cChar:GetAttribute("IsCarried") == true
            local isHooked = cChar:GetAttribute("IsHooked") == true
            local cRoot = cChar:FindFirstChild("HumanoidRootPart")
            if isDown and not isCarried and not isHooked and cRoot then
                local dist = (cRoot.Position - root.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = cChar
                end
            end
        end
    end
    return closest, shortestDist
end

