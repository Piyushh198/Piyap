local function ensureParryingDaggerEquipped(char)
    if not char then return false end
    if EspEngine.isParryingDaggerEquipped(char) then return true end
    local bp = player:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then
                local nl = t.Name:lower()
                if PARRY_DAGGER_NAMES[nl] or nl:find("dagger") or nl:find("parry") or nl:find("scythe") or nl:find("fih") or nl:find("enten") then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum:EquipTool(t)
                        return true
                    end
                end
            end
        end
    end
    return false
end

