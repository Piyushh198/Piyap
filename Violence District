function EspEngine.getKillerWeaponHand(kChar)
    local hands = EspEngine.getKillerHands(kChar)
    if not hands then return nil end
    return hands.weapon or hands.right or hands.left or hands.root
end

-- HELPER: Strict non-combat filter (pickup survivor, vaulting, pallet break, gen break, stuns, abilities)
function EspEngine.isKillerBusyWithNonCombat(kChar)
    if not kChar then return true end

    -- Check attributes on Killer
    local action = tostring(kChar:GetAttribute("Action") or ""):lower()
    local actionState = tostring(kChar:GetAttribute("ActionState") or ""):lower()

    -- 1. Survivor pickup / carry / hook / lift
    if kChar:GetAttribute("IsCarrying") == true or
       kChar:GetAttribute("Carrying") == true or
       kChar:GetAttribute("IsPickingUp") == true or
       kChar:GetAttribute("PickingUp") == true or
       action:find("carry") or action:find("pickup") or action:find("hook") or action:find("lift") or
       actionState:find("carry") or actionState:find("pickup") or actionState:find("hook") or actionState:find("lift") or
       CollectionService:HasTag(kChar, "Carrying") then
        return true
    end

    -- 2. Vaulting windows / obstacles
    if kChar:GetAttribute("isVaulting") == true or
       kChar:GetAttribute("Vaulting") == true or
       action:find("vault") or actionState:find("vault") then
        return true
    end

    -- 3. Breaking pallets or generators
    if kChar:GetAttribute("isBreaking") == true or
       kChar:GetAttribute("isBreakingPallet") == true or
       kChar:GetAttribute("Breaking") == true or
       action:find("break") or action:find("destroy") or action:find("pallet") or action:find("gen") or action:find("kick") or
       actionState:find("break") or actionState:find("destroy") or actionState:find("pallet") or actionState:find("gen") or actionState:find("kick") then
        return true
    end

    -- 4. Stunned / immobile / cooldown
    if kChar:GetAttribute("IsStunned") == true or
       kChar:GetAttribute("Stunned") == true or
       kChar:GetAttribute("Immobile") == true or
       action:find("stun") or actionState:find("stun") then
        return true
    end

    -- 5. Off-Hand Abilities (e.g. chains, spears, flasks, potions, casts, aim)
    if kChar:GetAttribute("UsingAbility") == true or
       kChar:GetAttribute("IsUsingAbility") == true or
       kChar:GetAttribute("IsThrowing") == true or
       kChar:GetAttribute("Throwing") == true or
       kChar:GetAttribute("AbilityActive") == true or
       kChar:GetAttribute("AbilityAiming") == true or
       kChar:GetAttribute("ChainAiming") == true or
       kChar:GetAttribute("SpearAiming") == true or
       kChar:GetAttribute("FlaskThrowing") == true or
       kChar:GetAttribute("IsAiming") == true or
       kChar:GetAttribute("Casting") == true or
       action:find("ability") or action:find("throw") or action:find("chain") or action:find("spear") or action:find("flask") or action:find("cast") or action:find("aim") or action:find("power") or action:find("skill") or
       actionState:find("ability") or actionState:find("throw") or actionState:find("chain") or actionState:find("spear") or actionState:find("flask") or actionState:find("cast") or actionState:find("aim") or actionState:find("power") or actionState:find("skill") then
        return true
    end

    -- Check CheckInterractable child if present
    local ci = kChar:FindFirstChild("CheckInterractable")
    if ci then
        if ci:GetAttribute("isVaulting") == true or
           ci:GetAttribute("isBreaking") == true or
           ci:GetAttribute("isCarrying") == true or
           ci:GetAttribute("isPickingUp") == true or
           ci:GetAttribute("UsingAbility") == true or
           ci:GetAttribute("isAiming") == true then
            return true
        end
    end

    -- 6. Check currently playing animations on killer
    local hum = kChar:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.IsPlaying then
                local animName = (track.Name or ""):lower()
                local animId = (track.Animation and track.Animation.AnimationId) or ""

                -- Vaulting
                if animName:find("vault") or animId:find("127657662249554") or animId:find("124245602682129") then
                    return true
                end

                -- Pallet breaking
                if animName:find("breakpallet") or animName:find("palletbreak") or animName:find("destroy") or
                   animId:find("135181748009911") or animId:find("79144702364921") then
                    return true
                end

                -- Generator breaking / kick
                if animName:find("breakgen") or animName:find("genbreak") or animName:find("damagegen") or
                   (animName == "kick" and not animName:find("attack")) or animId:find("111387253672755") then
                    return true
                end

                -- Survivor pickup / carry / hook
                if animName:find("pickup") or animName:find("carry") or animName:find("hook") or animName:find("lift") or
                   animId:find("108286715411226") or animId:find("87833180786200") or animId:find("75825369929893") or
                   animId:find("84065325761108") or animId:find("99837327705528") or animId:find("84390193150093") then
                    return true
                end

                -- Stunned / wipe blade / clean / parried
                if animName:find("stun") or animName:find("hitreaction") or animName:find("wipe") or animName:find("cooldown") or
                   animName:find("wallhit") or animName:find("parried") or animId:find("98704572602731") or
                   animId:find("72346764885778") or animId:find("77647134875637") or animId:find("70835133748914") or
                   animId:find("100439096846839") or animId:find("104441592641498") or animId:find("135232576906772") or
                   animId:find("139552764914767") then
                    return true
                end

                -- Abilities / off-hand throws / powers (MUST NOT PARRY)
                if animName:find("ability") or animName:find("throw") or animName:find("chain") or animName:find("spear") or 
                   animName:find("flask") or animName:find("cast") or animName:find("power") or animName:find("aim") or 
                   animName:find("skill") or animName:find("offhand") or animName:find("potion") or animName:find("projectile") then
                    return true
                end
            end
        end
    end

    return false
end

-- LIVE DUAL-HAND TRACKER & COMBAT TARGETING DISCRIMINATOR
function EspEngine.isKillerAttackingMe(kChar)
    if not kChar then return false end
    local myChar = player.Character
    if not myChar then return false end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local kRoot = kChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not kRoot then return false end

    -- 0. LOCAL SURVIVOR WALKING GUARD: strictly do not parry if local player is walking/moving
    if not parryWhileWalking and isLocalPlayerWalking() then
        return false
    end

    -- 1. STRICT NON-COMBAT FILTER: Exclude pickup, vault, pallet break, gen break, stuns, abilities
    if EspEngine.isKillerBusyWithNonCombat(kChar) then
        return false
    end

    -- 2. Detect Attack or Lunge Action (STRICT COMBAT ONLY - NO WALKING/LOCOMOTION FALSE POSITIVES)
    local isAttacking = false
    local isLunging = false

    -- Check killer attributes
    if kChar:GetAttribute("SwingActive") == true or 
       kChar:GetAttribute("IsSwinging") == true or 
       kChar:GetAttribute("Attacking") == true or 
       kChar:GetAttribute("FrenzyLungePending") == true or
       tostring(kChar:GetAttribute("ActionState")):lower():find("attack") or
       tostring(kChar:GetAttribute("Action")):lower():find("attack") then
        isAttacking = true
    end

    if kChar:GetAttribute("IsLunging") == true or
       kChar:GetAttribute("lunging") == true or
       tostring(kChar:GetAttribute("ActionState")):lower():find("lunge") or
       tostring(kChar:GetAttribute("Action")):lower():find("lunge") then
        isAttacking = true
        isLunging = true
    end

    -- Weapon trails (SwingVisuals activates SwingTrail on weapon exclusively during active melee swings)
    for _, desc in ipairs(kChar:GetDescendants()) do
        if desc:IsA("Trail") and desc.Enabled then
            local n = desc.Name:lower()
            if n:find("swing") or n:find("slash") or n:find("attack") or desc:GetAttribute("SwingTrail") then
                isAttacking = true
                break
            end
        end
    end

    -- Active animation tracks
    local kHum = kChar:FindFirstChildOfClass("Humanoid")
    local animator = kHum and kHum:FindFirstChildOfClass("Animator")
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            if track.IsPlaying then
                local animName = (track.Name or ""):lower()
                local animId = (track.Animation and track.Animation.AnimationId) or ""

                -- Explicit lunge animations
                if animName:find("lunge") or animName:find("frenzylunge") or animName:find("toollunge") or
                   animId:find("129626174716003") or animId:find("138606330835999") or
                   animId:find("105374834496520") or animId:find("115244153053858") or animId:find("129967478") or
                   animId:find("85894094209457") or animId:find("110045688062234") or
                   animId:find("129570234771869") or animId:find("130915693370693") or
                   animId:find("86213737463907") or animId:find("100395868673407") or
                   animId:find("110881025348309") or animId:find("119792658841268") or animId:find("81019828986691") then
                    isAttacking = true
                    isLunging = true
                    break
                -- Explicit melee attack / swing animations
                elseif animName:find("attack") or animName:find("swing") or animName:find("slash") or 
                       animName:find("m1") or animName:find("hit") or animName:find("strike") or animName:find("stab") or
                       animName == "attackfr" or animName == "attacktony" or animName == "attackcobra" or animName == "attackalex" or
                       animName == "toolslash" or
                       animId:find("113691709436161") or animId:find("132549827448757") or
                       animId:find("134862031194933") or animId:find("136973921948245") or
                       animId:find("110441838520158") or animId:find("108114231850675") or
                       animId:find("111920872708571") or animId:find("138720291317243") or animId:find("130593238885843") then
                    isAttacking = true
                    break
                end
            end
        end
    end

    -- If killer is NOT verified to be actively attacking or lunging, reject
    if not isAttacking then return false end

    -- 3. DUAL-HAND & WEAPON TRACKING
    local hands = EspEngine.getKillerHands(kChar)
    local kLook = kRoot.CFrame.LookVector
    local kPos = kRoot.Position
    local myPos = myRoot.Position

    -- 2D horizontal vector (neutralizes height & slope variance)
    local toMe2D = Vector3.new(myPos.X - kPos.X, 0, myPos.Z - kPos.Z)
    local distRootToMe = toMe2D.Magnitude
    local kLook2D = Vector3.new(kLook.X, 0, kLook.Z).Unit
    local forwardDist = toMe2D:Dot(kLook2D)
    local aimDotToMe = (distRootToMe > 0.05) and (toMe2D.Unit:Dot(kLook2D)) or 1.0

    -- Evaluate candidate hands (Right Arm, Left Arm, Weapon)
    local closestHandDist = 999
    local candidateParts = hands and hands.candidates or {}

    for _, part in ipairs(candidateParts) do
        local pPos = part.Position
        local d = (myPos - pPos).Magnitude
        if d < closestHandDist then
            closestHandDist = d
        end
    end

    -- Fallback if no parts found
    if closestHandDist == 999 then
        closestHandDist = distRootToMe
    end

    -- 4. RANGE & GEOMETRIC TARGETING VERIFICATION
    local maxHandReach = isLunging and 14.5 or 10.5
    local maxRootRange = isLunging and 15.5 or 11.5

    -- Must be within hand reach or root attack distance
    if closestHandDist > maxHandReach and distRootToMe > maxRootRange then
        return false
    end

    -- Must be in front of killer (not behind or directly beside)
    if forwardDist < 0.2 then
        return false
    end

    -- Inside horizontal swing arc (5.8 studs lateral allowance)
    local lateralDist = (toMe2D - (kLook2D * forwardDist)).Magnitude
    if lateralDist > 5.8 then
        return false
    end

    -- Killer must be facing toward us (> 75-degree frontal cone)
    if aimDotToMe < 0.30 then
        return false
    end

    -- 5. MULTI-PLAYER TARGET DISAMBIGUATION: Is killer attacking someone else?
    for _, otherPlr in ipairs(Players:GetPlayers()) do
        if otherPlr ~= player and otherPlr.Character then
            local oChar = otherPlr.Character
            local isOtherKiller = (otherPlr.Team and otherPlr.Team.Name == "Killer") or
                                  CollectionService:HasTag(oChar, "Killer") or
                                  oChar:GetAttribute("Killer") or
                                  oChar:GetAttribute("MorphedKiller")
            if not isOtherKiller and not oChar:GetAttribute("Knocked") and not oChar:GetAttribute("IsHooked") then
                local oRoot = oChar:FindFirstChild("HumanoidRootPart")
                if oRoot then
                    local oPos = oRoot.Position
                    local toOther2D = Vector3.new(oPos.X - kPos.X, 0, oPos.Z - kPos.Z)
                    local distToOther = toOther2D.Magnitude
                    local aimDotToOther = (distToOther > 0.05) and (toOther2D.Unit:Dot(kLook2D)) or 1.0

                    -- If killer is closer to other survivor AND aiming significantly more directly at them
                    if (distToOther < distRootToMe - 1.2) and (aimDotToOther > aimDotToMe + 0.15) and distToOther <= 9.5 then
                        return false
                    end
                    -- Point-blank attack on other survivor while local player is further away
                    if aimDotToOther > 0.88 and distToOther < 6.0 and distRootToMe > 6.5 then
                        return false
                    end
                end
            end
        end
    end

    return true
end

-- Backward compatibility alias
function EspEngine.isKillerAttacking(kChar)
    return EspEngine.isKillerAttackingMe(kChar)
end

-- Dedicated helper to verify if a character is a Killer
local function isCharacterKiller(c)
    if not c or not c:IsA("Model") then return false end
    if CollectionService:HasTag(c, "Killer") then return true end
    if c:GetAttribute("Killer") == true or c:GetAttribute("MorphedKiller") ~= nil then return true end
    local plr = Players:GetPlayerFromCharacter(c)
    if plr then
        if plr.Team and plr.Team.Name:lower() == "killer" then return true end
        if plr:GetAttribute("Killer") == true or plr:GetAttribute("Role") == "Killer" then return true end
    end
    local nl = c.Name:lower()
    if nl:find("killer") then return true end
    return false
end

-- Reactive animation listener for killers (zero latency, only binds to actual killers)
local function bindKillerInstantParry(kChar)
    if not isCharacterKiller(kChar) then return end
    local hum = kChar:WaitForChild("Humanoid", 3) or kChar:FindFirstChildOfClass("Humanoid")
    local animator = hum and (hum:WaitForChild("Animator", 3) or hum:FindFirstChildOfClass("Animator"))
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if not autoParryEnabled then return end
            if not parryWhileWalking and isLocalPlayerWalking() then return end
            local char = player.Character
            if not char or (not EspEngine.isParryingDaggerEquipped(char) and not ensureParryingDaggerEquipped(char)) then return end
            if char:FindFirstChild("Twist of Fate") then return end

            -- Recheck targeting: only parry if killer is attacking ME (not other players)
            if EspEngine.isKillerAttackingMe(kChar) then
                EspEngine.triggerParry()
            else
                task.defer(function()
                    if autoParryEnabled and (parryWhileWalking or not isLocalPlayerWalking()) and EspEngine.isKillerAttackingMe(kChar) then
                        EspEngine.triggerParry()
                    end
                end)
            end
        end)
    end
end

pcall(function()
    CollectionService:GetInstanceAddedSignal("Killer"):Connect(bindKillerInstantParry)
    for _, k in ipairs(CollectionService:GetTagged("Killer")) do
        task.spawn(bindKillerInstantParry, k)
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            p.CharacterAdded:Connect(function(c)
                task.wait(0.5)
                if isCharacterKiller(c) then
                    bindKillerInstantParry(c)
                end
            end)
            if p.Character and isCharacterKiller(p.Character) then
                task.spawn(bindKillerInstantParry, p.Character)
            end
        end
    end
    Players.PlayerAdded:Connect(function(p)
        if p ~= player then
            p.CharacterAdded:Connect(function(c)
                task.wait(0.5)
                if isCharacterKiller(c) then
                    bindKillerInstantParry(c)
                end
            end)
        end
    end)
end)

function EspEngine.getBasePart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end
local function getBasePart(obj)
    return EspEngine.getBasePart(obj)
end

function EspEngine.getVaultHighlightTarget(model)
    if not model then return nil end
    if model:IsA("BasePart") then
        if model.Name == "Bottom" or model.Name == "VaultTrigger" then return model end
        return nil
    end
    local bottom = model:FindFirstChild("Bottom")
    if bottom and bottom:IsA("BasePart") then return bottom end
    local vt = model:FindFirstChild("VaultTrigger")
    if vt and vt:IsA("BasePart") then return vt end
    return nil
end

function EspEngine.getOrCreateHighlight(obj, name, color, targetPartOverride)
    if staticHighlights[obj] and staticHighlights[obj].Parent then
        local hl = staticHighlights[obj]
        hl.FillColor = color
        hl.OutlineColor = (name == "PiyapVaultESP") and Color3.fromRGB(255, 235, 0) or color
        return hl
    end
    local hl = Instance.new("Highlight")
    hl.Name = name
    local targetAdornee = (name == "PiyapVaultESP" and targetPartOverride) or (obj:IsA("Model") and obj) or (obj:FindFirstAncestorOfClass("Model") or targetPartOverride or obj)
    hl.Adornee = targetAdornee
    hl.FillColor = color
    hl.OutlineColor = (name == "PiyapVaultESP") and Color3.fromRGB(255, 235, 0) or color
    hl.FillTransparency = (name == "PiyapVaultESP") and 0.25 or 0.4
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = targetAdornee
    staticHighlights[obj] = hl
    return hl
end

function EspEngine.updateStaticObjectESP(obj, enabled, name, color, targetPartOverride)
    if not enabled or not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then
        if staticHighlights[obj] then staticHighlights[obj]:Destroy(); staticHighlights[obj] = nil end
        if staticTags[obj] and staticTags[obj].Gui then staticTags[obj].Gui:Destroy(); staticTags[obj] = nil end
        if name == "PiyapVaultESP" and vaultAdornments[obj] then
            vaultAdornments[obj]:Destroy()
            vaultAdornments[obj] = nil
        end
        return
    end

    local targetPart = targetPartOverride or EspEngine.getBasePart(obj)
    if not targetPart then return end

    if name == "PiyapVaultESP" then
        if EspState.highlight then
            if not vaultAdornments[obj] or not vaultAdornments[obj].Parent then
                local box = Instance.new("BoxHandleAdornment")
                box.Name = "PiyapVaultBox"
                box.Size = targetPart.Size + Vector3.new(0.02, 0.02, 0.02)
                box.Color3 = Color3.fromRGB(255, 235, 0)
                box.Transparency = 0.35
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Adornee = targetPart
                box.Parent = espContainer
                vaultAdornments[obj] = box
            else
                local box = vaultAdornments[obj]
                box.Adornee = targetPart
                box.Size = targetPart.Size + Vector3.new(0.02, 0.02, 0.02)
                box.Color3 = Color3.fromRGB(255, 235, 0)
                box.Visible = true
            end
            EspEngine.getOrCreateHighlight(obj, name, color, targetPart)
        else
            if vaultAdornments[obj] then vaultAdornments[obj]:Destroy(); vaultAdornments[obj] = nil end
            if staticHighlights[obj] then staticHighlights[obj]:Destroy(); staticHighlights[obj] = nil end
        end
    else
        if EspState.highlight then
            EspEngine.getOrCreateHighlight(obj, name, color, targetPart)
        else
            if staticHighlights[obj] then staticHighlights[obj]:Destroy(); staticHighlights[obj] = nil end
        end
    end

    if EspState.name or EspState.distance or (name == "PiyapGenESP" and EspState.genPercentage) then
        if not staticTags[obj] then
            local tagGui = Instance.new("BillboardGui")
            tagGui.Name = name .. "_Tag"
            tagGui.Adornee = targetPart
            tagGui.Size = UDim2.new(0, 200, 0, 50)
            tagGui.StudsOffset = (name == "PiyapGenESP" and targetPart and targetPart.Name == "RootPart") and Vector3.new(0, 3.2, 0) or Vector3.new(0, 0, 0)
            tagGui.AlwaysOnTop = true
            tagGui.Parent = espContainer

            local textLabel = Instance.new("TextLabel")
            textLabel.Name = "TagText"
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.TextColor3 = color
            textLabel.TextStrokeTransparency = 0.5
            textLabel.Font = Enum.Font.GothamBold
            textLabel.TextSize = 12
            textLabel.Parent = tagGui

            staticTags[obj] = {Gui = tagGui, Label = textLabel, Name = name}
        end

        local tagData = staticTags[obj]
        if tagData and tagData.Gui and tagData.Label then
            tagData.Gui.Adornee = targetPart
            if name == "PiyapGenESP" then
                tagData.Gui.StudsOffset = (targetPart and targetPart.Name == "RootPart") and Vector3.new(0, 3.2, 0) or Vector3.new(0, 0, 0)
            end
            tagData.Label.TextColor3 = color
            local textParts = {}
            if EspState.name then
                local displayName = obj.Name
                if name == "PiyapPalletESP" then
                    displayName = "Pallet"
                elseif name == "PiyapPumpkinESP" then
                    displayName = "Pumpkin"
                elseif name == "PiyapVaultESP" then
                    displayName = "Vault"
                elseif name == "PiyapTrapESP" then
                    displayName = "Trap"
                elseif name == "PiyapScpESP" then
                    displayName = "Zombie"
                elseif name == "PiyapHookESP" then
                    displayName = "Hook"
                elseif name == "PiyapGenESP" then
                    displayName = "Generator"
                elseif name == "PiyapGateESP" then
                    displayName = "Gate"
                end
                table.insert(textParts, displayName)
            end
            if EspState.distance and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((player.Character.HumanoidRootPart.Position - targetPart.Position).Magnitude)
                table.insert(textParts, "[" .. dist .. "s]")
            end
            if name == "PiyapGenESP" and EspState.genPercentage then
                local progress = obj:GetAttribute("RepairProgress") or 0
                local pColor = Color3.fromRGB(255, 0, 0)
                if progress >= 70 then
                    pColor = Color3.fromRGB(0, 255, 0)
                elseif progress >= 50 then
                    pColor = Color3.fromRGB(255, 255, 0)
                end
                table.insert(textParts, tostring(math.floor(progress)))
                tagData.Label.TextColor3 = pColor
            end
            tagData.Label.Text = table.concat(textParts, " ")
            tagData.Gui.Enabled = (#textParts > 0)
        end
    else
        if staticTags[obj] and staticTags[obj].Gui then
            staticTags[obj].Gui.Enabled = false
        end
    end
end

function EspEngine.clearHighlights(nameFilter)
    for obj, hl in pairs(staticHighlights) do
        if hl and hl.Name == nameFilter then
            hl:Destroy()
            staticHighlights[obj] = nil
        end
    end
    for obj, tagData in pairs(staticTags) do
        if tagData and tagData.Name == nameFilter then
            if tagData.Gui then tagData.Gui:Destroy() end
            staticTags[obj] = nil
        end
    end
    if nameFilter == "PiyapVaultESP" then
        for obj, adorn in pairs(vaultAdornments) do
            if adorn then adorn:Destroy() end
            vaultAdornments[obj] = nil
        end
    end
end

function EspEngine.refreshAllActiveStaticESP()
    if EspState.hook then
        for obj, hp in pairs(espCache.Hooks) do
            local tPart = (typeof(hp) == "Instance" and hp) or obj:FindFirstChild("HookPoint") or EspEngine.getBasePart(obj)
            EspEngine.updateStaticObjectESP(obj, true, "PiyapHookESP", Color3.fromRGB(255, 0, 0), tPart)
        end
    end
    if EspState.gen then
        for obj, targetPart in pairs(espCache.Generators) do
            local isCompleted = obj:GetAttribute("Completed") == true or obj:GetAttribute("RepairProgress") == 100
            local col = isCompleted and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 170, 0)
            local tPart = (typeof(targetPart) == "Instance" and targetPart.Parent and targetPart) or obj:FindFirstChild("HitBox") or obj:FindFirstChild("GeneratorBody") or obj:FindFirstChild("RootPart") or EspEngine.getBasePart(obj)
            EspEngine.updateStaticObjectESP(obj, true, "PiyapGenESP", col, tPart)
        end
    end
    if EspState.pallet then
        for obj, targetPart in pairs(espCache.Pallets) do
            EspEngine.updateStaticObjectESP(obj, true, "PiyapPalletESP", Color3.fromRGB(150, 50, 255), targetPart)
        end
